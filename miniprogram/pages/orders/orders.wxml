<ui-page title="我的订单" subtitle="充值订单与支付状态">
  <view wx:if="{{loading && orders.length === 0}}">
    <ui-card>
      <text class="loading-state">正在加载...</text>
    </ui-card>
  </view>

  <view wx:elif="{{orders.length === 0}}">
    <ui-empty text="暂无订单" />
  </view>

  <view wx:else>
    <view
      wx:for="{{orders}}"
      wx:key="orderNo"
      class="card info-card"
    >
      <view class="info-card__top">
        <text class="info-card__id">{{item.orderNo}}</text>
        <ui-status text="{{item.statusText}}" type="{{item.statusType}}" />
      </view>
      <view class="info-card__row">
        <text class="info-card__label">{{item.packageKey}}</text>
        <text class="info-card__amount">¥{{item.amountYuan}}</text>
      </view>
      <view class="info-card__row">
        <text class="info-card__label">到账积分</text>
        <ui-price value="{{item.pointsTotal}}" type="points" size="sm" />
      </view>
      <view class="info-card__footer">
        <text class="info-card__time">{{item.createdAtText}}</text>
        <text wx:if="{{item.paidAtText !== '-'}}" class="info-card__time">支付于 {{item.paidAtText}}</text>
      </view>
    </view>

    <view wx:if="{{hasMore}}" class="load-more" bindtap="onReachBottom">
      <text class="load-more__text">加载更多...</text>
    </view>
    <view wx:elif="{{orders.length > 0}}" class="load-more">
      <text class="load-more__text">没有更多订单了</text>
    </view>
  </view>
</ui-page>
