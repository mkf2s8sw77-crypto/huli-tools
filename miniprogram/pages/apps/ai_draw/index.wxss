/* AI 绘图 v2 — 应用执行页 */

.app-exec-header {
  margin-bottom: var(--spacing-md);
}

.app-exec-header__row {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.app-exec-header__info {
  display: flex;
  flex-direction: column;
}

.app-exec-header__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.app-exec-header__cost {
  font-size: 24rpx;
  color: var(--color-accent-warm);
  font-weight: 500;
  margin-top: 2rpx;
}

.prompt-input {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm);
  font-size: 30rpx;
  box-sizing: border-box;
  background: var(--color-surface);
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: var(--spacing-xs);
}

.app-exec-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
  margin: var(--spacing-md) 0;
}

.app-exec-btn {
  width: 100%;
}

.app-exec-cancel {
  margin-top: 0;
}

.app-exec-result {
  text-align: center;
  padding: var(--spacing-lg);
}

.app-exec-result__label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: var(--spacing-sm);
}

.result-image {
  width: 100%;
  max-height: 800rpx;
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-md);
}

.save-btn {
  margin-top: var(--spacing-sm);
  border-radius: var(--radius-md) !important;
}

.app-exec-error {
  background: var(--color-danger-light);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-top: var(--spacing-md);
  text-align: center;
}

.app-exec-error text {
  font-size: 28rpx;
  color: var(--color-danger);
}
