<ui-page title="积分流水" subtitle="所有积分变动记录">
  <view wx:if="{{loading && list.length === 0}}">
    <ui-card>
      <text class="loading-state">正在加载...</text>
    </ui-card>
  </view>

  <view wx:elif="{{list.length === 0}}">
    <ui-empty text="暂无流水记录" />
  </view>

  <view wx:else>
    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="card info-card"
    >
      <view class="info-card__top">
        <ui-status text="{{item.typeText}}" type="{{item.typeStatus}}" />
        <text class="info-card__time">{{item.createdAtText}}</text>
      </view>
      <view class="tx-deltas">
        <view wx:if="{{item.deltaAvailable !== 0}}" class="tx-delta-chip {{item.deltaAvailable > 0 ? 'tx-delta-chip--plus' : 'tx-delta-chip--minus'}}">
          <text>可用 {{item.deltaAvailableText}}</text>
        </view>
        <view wx:if="{{item.deltaFrozen !== 0}}" class="tx-delta-chip">
          <text>冻结 {{item.deltaFrozenText}}</text>
        </view>
      </view>
      <view class="info-card__footer">
        <text class="info-card__time">可用: {{item.availableAfter}} / 冻结: {{item.frozenAfter}}</text>
      </view>
      <text wx:if="{{item.note}}" class="tx-note">{{item.note}}</text>
    </view>

    <view wx:if="{{hasMore}}" class="load-more" bindtap="onReachBottom">
      <text class="load-more__text">加载更多...</text>
    </view>
    <view wx:elif="{{list.length > 0}}" class="load-more">
      <text class="load-more__text">没有更多记录了</text>
    </view>
  </view>
</ui-page>
