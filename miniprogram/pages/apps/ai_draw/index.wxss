/* AI 绘图页面私有样式 */

.cost-points {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-price);
}

.prompt-input {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

.image-card {
  text-align: center;
}

.result-image {
  width: 100%;
  max-height: 800rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.save-btn {
  margin-top: 16rpx;
}

.btn-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.cancel-btn {
  margin-top: 8rpx;
}

.error-card {
  background: var(--color-danger-light);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-top: 24rpx;
}

.error-card text {
  display: block;
  font-size: 28rpx;
  color: var(--color-danger);
  text-align: center;
}
