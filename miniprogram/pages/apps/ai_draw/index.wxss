/* AI 绘图 v2 — 应用执行页 */

.app-exec-header {
  margin-bottom: 34rpx;
  padding: 34rpx;
  border-radius: var(--radius-xl);
  background: var(--gradient-hero);
  box-shadow: var(--shadow-elevated);
  position: relative;
  overflow: hidden;
}

.app-exec-header::after {
  content: '';
  position: absolute;
  right: -42rpx;
  top: -54rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  background: var(--color-on-primary);
  opacity: 0.14;
}

.app-exec-header__row {
  display: flex;
  align-items: center;
  gap: 26rpx;
  position: relative;
  z-index: 1;
}

.app-exec-header__info {
  display: flex;
  flex-direction: column;
}

.app-exec-header__name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-on-primary);
  line-height: 1.25;
}

.app-exec-header__cost {
  align-self: flex-start;
  font-size: 25rpx;
  color: var(--color-accent-warm);
  background: rgba(255, 255, 255, 0.84);
  border-radius: var(--radius-pill);
  padding: 7rpx 18rpx;
  font-weight: 700;
  margin-top: 10rpx;
}

.app-exec-header .icon-tile {
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: none;
  --icon-line: var(--color-on-primary);
}

.prompt-input {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-peach-light) 100%);
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: var(--spacing-xs);
}

.app-exec-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
  margin: var(--spacing-md) 0;
}

.app-exec-btn {
  width: 100%;
}

.app-exec-cancel {
  margin-top: 0;
}

.app-exec-result {
  text-align: center;
  padding: var(--spacing-lg);
  background: linear-gradient(135deg, var(--color-bg-card) 0%, var(--color-peach-light) 100%);
}

.app-exec-result__label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: var(--spacing-sm);
}

.result-image {
  width: 100%;
  max-height: 800rpx;
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-md);
}

.save-btn {
  margin-top: var(--spacing-sm);
  border-radius: var(--radius-md) !important;
}

.app-exec-error {
  background: var(--color-danger-light);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-top: var(--spacing-md);
  text-align: center;
}

.app-exec-error text {
  font-size: 28rpx;
  color: var(--color-danger);
}
