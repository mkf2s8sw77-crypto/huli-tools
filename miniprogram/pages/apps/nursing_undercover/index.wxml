<ui-page>
  <!-- 应用头部 -->
  <view class="app-exec-header">
    <view class="app-exec-header__row">
      <view class="icon-tile icon-tile--app icon-tile--lavender icon-tile--undercover">
        <view class="icon-tile__glyph"></view>
      </view>
      <view class="app-exec-header__info">
        <text class="app-exec-header__name">{{appInfo ? appInfo.name : '谁是卧底（护理版）'}}</text>
        <text class="app-exec-header__cost">{{costLabel}}</text>
      </view>
    </view>
  </view>

  <!-- 错误提示 -->
  <view wx:if="{{error}}" class="nu-error-bar">
    <text class="nu-error-bar__text">{{error}}</text>
    <view class="nu-error-bar__close" bindtap="clearError">×</view>
  </view>

  <!-- ===== 配置阶段 ===== -->
  <view wx:if="{{phase === 'config'}}">
    <view wx:if="{{configLoading}}" class="loading-state">加载配置中...</view>
    <view wx:else>
      <!-- 模式选择 -->
      <ui-form-field label="游戏模式">
        <view class="nu-option-group">
          <view
            wx:for="{{modes}}"
            wx:key="key"
            class="nu-option {{selectedMode === item.key ? 'nu-option--active' : ''}}"
            data-mode="{{item.key}}"
            bindtap="onModeChange"
          >
            <text class="nu-option__label">{{item.label}}</text>
            <text class="nu-option__desc">{{item.desc}}</text>
          </view>
        </view>
      </ui-form-field>

      <!-- 难度选择 -->
      <ui-form-field label="难度">
        <view class="nu-option-group nu-option-group--row">
          <view
            wx:for="{{difficulties}}"
            wx:key="key"
            class="nu-option nu-option--compact {{selectedDifficulty === item.key ? 'nu-option--active' : ''}}"
            data-difficulty="{{item.key}}"
            bindtap="onDifficultyChange"
          >
            <text class="nu-option__label">{{item.label}}</text>
          </view>
        </view>
      </ui-form-field>

      <!-- NPC 数 -->
      <ui-form-field label="AI 对手数量">
        <slider
          min="{{npcRange.min}}"
          max="{{npcRange.max}}"
          step="1"
          value="{{selectedNpcCount}}"
          show-value
          activeColor="var(--color-primary)"
          bindchange="onNpcCountChange"
        />
      </ui-form-field>

      <!-- 发言轮数 -->
      <ui-form-field label="发言轮数">
        <slider
          min="{{roundRange.min}}"
          max="{{roundRange.max}}"
          step="1"
          value="{{selectedRoundCount}}"
          show-value
          activeColor="var(--color-primary)"
          bindchange="onRoundCountChange"
        />
      </ui-form-field>

      <!-- 开始按钮 -->
      <view class="nu-action-area">
        <ui-action-button
          text="开始对局"
          loading="{{loading}}"
          disabled="{{loading}}"
          bind:tap="onStartGame"
        />
      </view>

      <!-- 最近对局 -->
      <view wx:if="{{historyGames.length > 0}}" class="nu-history-section">
        <text class="section-title">最近对局</text>
        <view class="nu-history-list">
          <view
            wx:for="{{historyGames}}"
            wx:key="_id"
            class="nu-history-item card"
            data-id="{{item._id}}"
            bindtap="onViewHistory"
          >
            <view class="nu-history-item__top">
              <text class="nu-history-item__title">{{item.scenarioTitle}}</text>
              <text class="status-tag {{item.status === 'finished' ? (item.result.playerWon ? 'status-tag--success' : 'status-tag--danger') : 'status-tag--default'}}">{{item.status === 'finished' ? item.resultLabel : item.statusLabel}}</text>
            </view>
            <view class="nu-history-item__bottom">
              <text class="text-muted">{{item.modeLabel}} · {{item.difficultyLabel}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{historyGames.length < historyTotal}}" class="load-more" bindtap="onLoadMoreHistory">
          <text class="load-more__text">{{historyLoading ? '加载中...' : '加载更多'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 游戏进行阶段 ===== -->
  <view wx:if="{{phase === 'game'}}">
    <!-- 身份卡 -->
    <view class="nu-identity-card card">
      <view class="nu-identity-card__header">
        <text class="nu-identity-card__title">你的身份密令</text>
        <text class="status-tag {{isUndercover ? 'status-tag--danger' : 'status-tag--info'}}">{{isUndercover ? '卧底' : '平民'}}</text>
      </view>
      <text class="nu-identity-card__secret">{{playerSecret}}</text>
      <text class="nu-identity-card__hint" wx:if="{{session.mode === 'word_undercover'}}">描述你的密令但不能直接说出来</text>
      <text class="nu-identity-card__hint" wx:else>围绕护理情境讨论，不能暴露你的具体措施</text>
    </view>

    <!-- 当前轮次 -->
    <view class="nu-round-header">
      <text class="section-title">第 {{session.currentRound}} / {{session.roundCount}} 轮</text>
    </view>

    <!-- 历史轮次发言 -->
    <view wx:for="{{allRoundSpeeches}}" wx:key="roundNo" wx:if="{{item.roundNo < session.currentRound}}">
      <text class="nu-round-label text-muted">第 {{item.roundNo}} 轮发言</text>
      <view class="nu-speech-list">
        <view wx:for="{{item.speeches}}" wx:for-item="speech" wx:key="roleId" class="nu-speech-bubble {{speech.actorType === 'player' ? 'nu-speech-bubble--player' : ''}}">
          <text class="nu-speech-bubble__name">{{speech.displayName}}</text>
          <text class="nu-speech-bubble__text">{{speech.text}}</text>
        </view>
      </view>
    </view>

    <!-- 当前轮发言 -->
    <view wx:if="{{currentRoundSpeeches.length > 0}}">
      <text class="nu-round-label text-muted">本轮已发言</text>
      <view class="nu-speech-list">
        <view wx:for="{{currentRoundSpeeches}}" wx:key="roleId" class="nu-speech-bubble {{item.actorType === 'player' ? 'nu-speech-bubble--player' : ''}}">
          <text class="nu-speech-bubble__name">{{item.displayName}}</text>
          <text class="nu-speech-bubble__text">{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- 发言输入 -->
    <view class="nu-input-area">
      <textarea
        class="nu-textarea form-input"
        placeholder="输入你的发言..."
        maxlength="200"
        value="{{speechText}}"
        bindinput="onSpeechInput"
        disabled="{{loading}}"
      />
      <view class="nu-input-footer">
        <text class="text-muted">{{speechText.length}}/200</text>
        <ui-action-button
          text="提交发言"
          size="small"
          loading="{{loading}}"
          disabled="{{loading || !canSubmitSpeech}}"
          bind:tap="onSubmitSpeech"
        />
      </view>
    </view>

    <view class="nu-cancel-area">
      <text class="nu-cancel-link text-muted" bindtap="onCancelGame">取消对局</text>
    </view>
  </view>

  <!-- ===== 投票阶段 ===== -->
  <view wx:if="{{phase === 'vote'}}">
    <view class="nu-identity-card card">
      <view class="nu-identity-card__header">
        <text class="nu-identity-card__title">你的身份密令</text>
        <text class="status-tag {{isUndercover ? 'status-tag--danger' : 'status-tag--info'}}">{{isUndercover ? '卧底' : '平民'}}</text>
      </view>
      <text class="nu-identity-card__secret">{{playerSecret}}</text>
    </view>

    <!-- 全部发言回顾 -->
    <text class="section-title">发言回顾</text>
    <view wx:for="{{allRoundSpeeches}}" wx:key="roundNo">
      <text class="nu-round-label text-muted">第 {{item.roundNo}} 轮</text>
      <view class="nu-speech-list">
        <view wx:for="{{item.speeches}}" wx:for-item="speech" wx:key="roleId" class="nu-speech-bubble {{speech.actorType === 'player' ? 'nu-speech-bubble--player' : ''}}">
          <text class="nu-speech-bubble__name">{{speech.displayName}}</text>
          <text class="nu-speech-bubble__text">{{speech.text}}</text>
        </view>
      </view>
    </view>

    <!-- 投票选择 -->
    <text class="section-title">选择你认为的卧底</text>
    <view class="nu-vote-list">
      <view
        wx:for="{{voteTargets}}"
        wx:key="roleId"
        class="nu-vote-option card {{selectedVoteTarget === item.roleId ? 'nu-vote-option--selected' : ''}}"
        data-role-id="{{item.roleId}}"
        bindtap="onSelectVoteTarget"
      >
        <text class="nu-vote-option__name">{{item.displayName}}</text>
        <view wx:if="{{selectedVoteTarget === item.roleId}}" class="nu-vote-option__check">✓</view>
      </view>
    </view>

    <view class="nu-action-area">
      <ui-action-button
        text="确认投票"
        loading="{{loading}}"
        disabled="{{loading || !selectedVoteTarget}}"
        bind:tap="onSubmitVote"
      />
    </view>

    <view class="nu-cancel-area">
      <text class="nu-cancel-link text-muted" bindtap="onCancelGame">取消对局</text>
    </view>
  </view>

  <!-- ===== 结果阶段 ===== -->
  <view wx:if="{{phase === 'result'}}">
    <!-- 胜负结果 -->
    <view wx:if="{{session.result}}" class="nu-result-card card {{session.result.playerWon ? 'nu-result-card--win' : 'nu-result-card--lose'}}">
      <text class="nu-result-card__title">{{session.result.playerWon ? '恭喜，你赢了！' : '很遗憾，你输了'}}</text>
      <text class="nu-result-card__subtitle">{{session.result.winner === 'civilian' ? '平民阵营胜利' : '卧底阵营胜利'}}</text>
      <view class="nu-result-card__details">
        <text>正确卧底：{{session.undercoverRoleId === 'player' ? '你自己' : undercoverName}}</text>
        <text>被投出的人：{{session.result.votedOutRoleId === 'player' ? '你自己' : votedOutName}}</text>
      </view>
    </view>

    <!-- 取消/失败状态 -->
    <view wx:if="{{session.status === 'cancelled'}}" class="nu-result-card card">
      <text class="nu-result-card__title">对局已取消</text>
    </view>
    <view wx:if="{{session.status === 'failed'}}" class="nu-result-card card">
      <text class="nu-result-card__title">对局失败</text>
      <text wx:if="{{session.errorMessage}}" class="text-muted">{{session.errorMessage}}</text>
    </view>

    <!-- 答案揭晓 -->
    <view wx:if="{{session.result}}" class="nu-reveal-section">
      <text class="section-title">答案揭晓</text>
      <view class="nu-role-list">
        <view wx:for="{{session.roles}}" wx:key="roleId" class="nu-role-item card">
          <view class="nu-role-item__header">
            <text class="nu-role-item__name">{{item.displayName}}</text>
            <text class="status-tag {{item.team === 'undercover' ? 'status-tag--danger' : 'status-tag--success'}}">{{item.team === 'undercover' ? '卧底' : '平民'}}</text>
          </view>
          <text class="nu-role-item__secret">密令：{{item.secretLabel}}</text>
        </view>
      </view>
    </view>

    <!-- 发言回顾 -->
    <text class="section-title">发言回顾</text>
    <view wx:for="{{allRoundSpeeches}}" wx:key="roundNo">
      <text class="nu-round-label text-muted">第 {{item.roundNo}} 轮</text>
      <view class="nu-speech-list">
        <view wx:for="{{item.speeches}}" wx:for-item="speech" wx:key="roleId" class="nu-speech-bubble {{speech.actorType === 'player' ? 'nu-speech-bubble--player' : ''}}">
          <text class="nu-speech-bubble__name">{{speech.displayName}}</text>
          <text class="nu-speech-bubble__text">{{speech.text}}</text>
        </view>
      </view>
    </view>

    <!-- 投票结果 -->
    <view wx:if="{{votesWithNames.length > 0}}">
      <text class="section-title">投票结果</text>
      <view class="nu-vote-result-list">
        <view wx:for="{{votesWithNames}}" wx:key="roleId" class="nu-vote-result-item">
          <text>{{item.voterName}} → {{item.targetName}}</text>
          <text wx:if="{{item.reason}}" class="text-muted"> ({{item.reason}})</text>
        </view>
      </view>
    </view>

    <!-- 教学复盘 -->
    <view wx:if="{{session.debrief}}" class="nu-debrief-section">
      <text class="section-title">教学复盘</text>
      <view class="card">
        <text class="nu-debrief__summary">{{session.debrief.summary}}</text>

        <view wx:if="{{session.debrief.keyClues.length > 0}}" class="nu-debrief__block">
          <text class="nu-debrief__label">关键线索</text>
          <view wx:for="{{session.debrief.keyClues}}" wx:key="*this" class="nu-debrief__item">
            <text>· {{item}}</text>
          </view>
        </view>

        <view wx:if="{{session.debrief.knowledgePoints.length > 0}}" class="nu-debrief__block">
          <text class="nu-debrief__label">知识点</text>
          <view wx:for="{{session.debrief.knowledgePoints}}" wx:key="*this" class="nu-debrief__item">
            <text>· {{item}}</text>
          </view>
        </view>

        <view wx:if="{{session.debrief.safetyNotes.length > 0}}" class="nu-debrief__block">
          <text class="nu-debrief__label">安全提醒</text>
          <view wx:for="{{session.debrief.safetyNotes}}" wx:key="*this" class="nu-debrief__item">
            <text>· {{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="nu-action-area">
      <ui-action-button text="再来一局" bind:tap="onNewGame" />
    </view>
  </view>
</ui-page>
