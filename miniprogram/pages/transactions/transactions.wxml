<ui-page title="积分流水">
  <view wx:if="{{loading && list.length === 0}}">
    <ui-card>
      <text class="loading-state">正在加载...</text>
    </ui-card>
  </view>

  <view wx:elif="{{list.length === 0}}">
    <ui-empty text="暂无流水记录" />
  </view>

  <view wx:else>
    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="tx-card"
    >
      <view class="list-row">
        <ui-status text="{{item.typeText}}" type="{{item.typeStatus}}" />
        <text class="tx-date">{{item.createdAtText}}</text>
      </view>
      <view class="list-row">
        <text wx:if="{{item.deltaAvailable !== 0}}" class="tx-delta">
          可用 {{item.deltaAvailableText}}
        </text>
        <text wx:if="{{item.deltaFrozen !== 0}}" class="tx-delta">
          冻结 {{item.deltaFrozenText}}
        </text>
      </view>
      <view class="list-row">
        <text class="tx-after">可用后: {{item.availableAfter}} / 冻结后: {{item.frozenAfter}}</text>
      </view>
      <view wx:if="{{item.note}}" class="list-row">
        <text class="tx-note">{{item.note}}</text>
      </view>
    </view>

    <view wx:if="{{hasMore}}" class="load-more" bindtap="onReachBottom">
      <text class="load-more__text">加载更多...</text>
    </view>
    <view wx:elif="{{list.length > 0}}" class="load-more">
      <text class="load-more__text">没有更多记录了</text>
    </view>
  </view>
</ui-page>
