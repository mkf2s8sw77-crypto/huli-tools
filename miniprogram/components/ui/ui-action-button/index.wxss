@import "../../../styles/common.wxss";

.ui-action-btn {
  min-height: 96rpx;
  border-radius: var(--radius-md) !important;
  font-weight: 800;
  font-size: 34rpx;
  letter-spacing: 0;
  box-shadow: 0 12rpx 32rpx rgba(124, 92, 252, 0.32) !important;
}

.ui-action-btn--loading {
  opacity: 0.7;
}

.ui-action-btn--disabled {
  opacity: 0.55;
  box-shadow: none !important;
}
