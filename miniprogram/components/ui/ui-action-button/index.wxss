@import "../../../styles/common.wxss";

.ui-action-btn {
  min-height: 96rpx;
  border-radius: var(--radius-lg) !important;
  font-weight: 700;
  font-size: 34rpx;
  letter-spacing: 0;
  box-shadow: 0 10rpx 24rpx rgba(94, 149, 200, 0.2) !important;
}

.ui-action-btn--loading {
  opacity: 0.7;
}

.ui-action-btn--disabled {
  opacity: 0.55;
  box-shadow: none !important;
}
