<ui-page variant="dashboard">
  <view wx:if="{{loading}}">
    <ui-card>
      <text class="loading-state">正在加载...</text>
    </ui-card>
  </view>

  <view wx:elif="{{error}}">
    <ui-error text="{{error}}" bind:retry="loadHomeData" />
  </view>

  <view wx:else>
    <!-- 积分摘要卡 -->
    <view wx:if="{{userSummary}}" class="points-hero">
      <view class="points-hero__main">
        <text class="points-hero__label">可用积分</text>
        <text class="points-hero__value">{{userSummary.points.availablePoints}}</text>
      </view>
      <view class="points-hero__action" bindtap="onGoRecharge">
        <text class="points-hero__action-text">充值</text>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="quick-nav">
      <view class="quick-nav__item" bindtap="onGoRecharge">
        <view class="quick-nav__icon icon-tile icon-tile--coral icon-tile--recharge">
          <view class="icon-tile__glyph"></view>
        </view>
        <text class="quick-nav__text">充值</text>
      </view>
      <view class="quick-nav__item" bindtap="onGoOrders">
        <view class="quick-nav__icon icon-tile icon-tile--lavender icon-tile--orders">
          <view class="icon-tile__glyph"></view>
        </view>
        <text class="quick-nav__text">订单</text>
      </view>
      <view class="quick-nav__item" bindtap="onGoTransactions">
        <view class="quick-nav__icon icon-tile icon-tile--teal icon-tile--transactions">
          <view class="icon-tile__glyph"></view>
        </view>
        <text class="quick-nav__text">流水</text>
      </view>
      <view class="quick-nav__item" bindtap="onGoUsageRecords">
        <view class="quick-nav__icon icon-tile icon-tile--peach icon-tile--records">
          <view class="icon-tile__glyph"></view>
        </view>
        <text class="quick-nav__text">记录</text>
      </view>
    </view>

    <!-- 应用目录 -->
    <ui-section title="应用目录">
      <ui-empty wx:if="{{apps.length === 0}}" text="暂无可用应用" />

      <view
        wx:for="{{apps}}"
        wx:key="appKey"
        class="app-card card"
        data-app="{{item}}"
        bindtap="onTapApp"
      >
        <view class="app-card__body">
          <view class="app-card__icon icon-tile icon-tile--app {{item.iconClass}}">
            <view class="icon-tile__glyph"></view>
          </view>
          <view class="app-card__info">
            <view class="app-card__title-row">
              <text class="app-card__name">{{item.name}}</text>
              <ui-status wx:if="{{item.status === 'coming_soon'}}" text="即将上线" type="warning" />
            </view>
            <text class="app-card__desc">{{item.description || ''}}</text>
            <view wx:if="{{item.pricing && item.pricing.mode === 'fixed'}}" class="app-card__cost">
              <text class="app-card__cost-text">{{item.pricing.costPoints}} 积分/次</text>
            </view>
          </view>
        </view>
        <view class="app-card__arrow"></view>
      </view>
    </ui-section>
  </view>
</ui-page>
