/* 充值页 v4.1 — Bento 工具墙 */

/* ── 标题区 ── */
.recharge-head {
  display: flex;
  flex-direction: column;
  margin-bottom: var(--spacing-lg);
}
.recharge-head__title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: -0.5rpx;
  line-height: 1.3;
}
.recharge-head__sub {
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin-top: 12rpx;
}

/* ── 充值包卡 ── */
.pkg-card {
  padding: 40rpx;
}
.pkg-card__hot {
  position: absolute;
  top: 0;
  right: 0;
  background: linear-gradient(90deg, #FF7A59 0%, #FF9A6B 100%);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 800;
  padding: 8rpx 24rpx;
  border-radius: 0 0 0 24rpx;
}
.pkg-card__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.pkg-card__name {
  font-size: 33rpx;
  font-weight: 800;
  color: var(--color-text);
}
.pkg-card__price {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-accent-warm);
  font-variant-numeric: tabular-nums;
}
.pkg-card__price-cur {
  font-size: 26rpx;
  font-weight: 600;
}
.pkg-card__lines {
  margin: 26rpx 0 32rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--color-border-soft);
}
.pkg-card__line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}
.pkg-card__label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.pkg-card__val {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
  font-variant-numeric: tabular-nums;
}
.pkg-card__val--bonus {
  color: var(--color-danger);
}
.pkg-card__line--total .pkg-card__label {
  color: var(--color-text-secondary);
}
.pkg-card__btn {
  width: 100%;
}

/* ── 模拟支付(开发/测试) ── */
.mock-card {
  border: 1rpx dashed var(--color-accent-warm);
  background: var(--color-accent-warm-light);
}
.mock-card__order {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: var(--spacing-sm);
  font-family: var(--font-mono);
}

/* ── 链接卡 ── */
.link-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 32rpx;
  margin-top: var(--spacing-md);
  cursor: pointer;
}
.link-card__text {
  font-size: 28rpx;
  color: var(--color-primary-hover);
  font-weight: 700;
}
