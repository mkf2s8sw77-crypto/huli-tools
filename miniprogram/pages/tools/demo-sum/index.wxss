/* demo-sum 页面私有样式 */

.cost-points {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-price);
}

.result .value {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-success);
  margin-top: 16rpx;
}

.subvalue {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

.error-card {
  background: var(--color-danger-light);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-top: 24rpx;
}

.error-card text {
  display: block;
  font-size: 28rpx;
  color: var(--color-danger);
  text-align: center;
}
