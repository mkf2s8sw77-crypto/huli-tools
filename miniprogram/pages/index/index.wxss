/* 首页 — 柔彩多巴胺仪表盘 */

/* ── 积分摘要卡 ── */
.points-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--gradient-hero);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg) var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-elevated);
  position: relative;
  overflow: hidden;
}

.points-hero::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--color-on-primary);
  opacity: 0.1;
}

.points-hero__main {
  display: flex;
  flex-direction: column;
}

.points-hero__label {
  font-size: 24rpx;
  color: var(--color-on-primary);
  opacity: 0.8;
  margin-bottom: 4rpx;
}

.points-hero__value {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--color-on-primary);
  letter-spacing: 0;
  line-height: 1.1;
}

.points-hero__action {
  background: rgba(255, 255, 255, 0.25);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: var(--radius-pill);
  padding: 12rpx 32rpx;
  backdrop-filter: blur(10px);
}

.points-hero__action-text {
  font-size: 26rpx;
  color: var(--color-on-primary);
  font-weight: 500;
}

/* ── 快捷入口 ── */
.quick-nav {
  display: flex;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
  padding: 0 var(--spacing-sm);
}

.quick-nav__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-xs);
}

.quick-nav__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  font-size: 30rpx;
}

.quick-nav__text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* ── 应用卡片 ── */
.app-card {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg) !important;
}

.app-card__body {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  flex: 1;
  min-width: 0;
}

.app-card__icon {
  flex-shrink: 0;
}

.app-card__info {
  flex: 1;
  min-width: 0;
}

.app-card__title-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: 4rpx;
}

.app-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.app-card__desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.app-card__cost {
  display: block;
  font-size: 22rpx;
  color: var(--color-accent-warm);
  margin-top: 4rpx;
  font-weight: 500;
}

.app-card__arrow {
  margin-left: var(--spacing-sm);
  font-size: 32rpx;
  color: var(--color-text-muted);
}
