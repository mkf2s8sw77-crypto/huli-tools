/* huli-tools 设计系统 v4.1 — Bento 工具墙
   通用样式层:所有页面都从这里取。
   衬线体系已移除:标题/数值统一 sans + font-weight:800 + tabular-nums
   (.serif-num 类名保留作向后兼容,但已改为 sans 粗体等宽数字)。
   微动效:点击波纹 / hover 抬起 / 加载渐变 / 进场 fade-in。 */

@import "./tokens.wxss";

/* ─────────────── 微动效基础 ─────────────── */

/* 全局点击波纹 */
.tap-feedback {
  position: relative;
  overflow: hidden;
}
.tap-feedback::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle, currentColor 1%, transparent 70%);
  opacity: 0;
  transform: scale(0.5);
  transition: opacity var(--t-base) var(--ease-out),
              transform var(--t-slow) var(--ease-out);
  pointer-events: none;
  color: var(--color-primary);
}
.tap-feedback:active::after {
  opacity: 0.15;
  transform: scale(1.5);
  transition: 0s;
}

/* fade-in 进场(用于 page 进入) */
@keyframes fade-in-up {
  from { opacity: 0; transform: translateY(8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.fade-in { animation: fade-in-up var(--t-slow) var(--ease-out) both; }
.fade-in-1 { animation-delay: 60ms; }
.fade-in-2 { animation-delay: 120ms; }
.fade-in-3 { animation-delay: 180ms; }
.fade-in-4 { animation-delay: 240ms; }

/* hover 抬起(主用于卡片) */
.lift-on-hover {
  transition: transform var(--t-base) var(--ease-out),
              box-shadow var(--t-base) var(--ease-out);
}
.lift-on-hover:hover {
  transform: translateY(-2rpx);
}

/* 加载渐变骨架 */
@keyframes shimmer {
  0%   { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}
.skeleton {
  background: linear-gradient(
    90deg,
    var(--color-border-soft) 0%,
    var(--color-surface) 50%,
    var(--color-border-soft) 100%
  );
  background-size: 200% 100%;
  animation: shimmer 1.4s linear infinite;
  border-radius: var(--radius-sm);
}

/* ─────────────── 页面容器 ─────────────── */
.container {
  padding: var(--spacing-lg);
}

/* ─────────────── 页面头部 ─────────────── */
.page-header {
  margin-bottom: var(--spacing-lg);
}

.page-title {
  display: block;
  font-family: var(--font-sans);
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: -0.5rpx;
  line-height: 1.3;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: var(--spacing-xs);
  font-family: var(--font-sans);
}

.page-eyebrow {
  display: block;
  font-size: 22rpx;
  color: var(--color-accent-warm);
  font-weight: 600;
  letter-spacing: 1.5rpx;
  text-transform: uppercase;
  margin-bottom: 6rpx;
  font-family: var(--font-sans);
}

/* 粗体等宽大数值(用于积分、价格等;类名沿用,衬线已移除) */
.serif-num {
  font-family: var(--font-sans);
  font-variant-numeric: tabular-nums;
  font-weight: 800;
  letter-spacing: -0.01em;
}

/* ─────────────── 区域标题 ─────────────── */
.section-title {
  display: block;
  font-family: var(--font-sans);
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.35;
  margin: 4rpx 0 22rpx;
  padding-left: 24rpx;
  position: relative;
}
.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 8rpx;
  border-radius: var(--radius-pill);
  background: linear-gradient(180deg, #7C5CFC 0%, #B893F6 100%);
}

/* ─────────────── 卡片 ─────────────── */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border);
  position: relative;
  overflow: hidden;
  transition: transform var(--t-base) var(--ease-out),
              box-shadow var(--t-base) var(--ease-out);
}
.card.tap-feedback:active { transform: scale(0.99); }
.card.lift-on-hover:hover { transform: translateY(-2rpx); box-shadow: var(--shadow-elevated); }

.card--elevated {
  box-shadow: var(--shadow-elevated);
  border-color: var(--color-border);
}

.card--soft {
  background: var(--color-surface);
  border-color: var(--color-border-soft);
}

.card--hero {
  background: var(--gradient-hero);
  color: var(--color-on-primary);
  border: none;
  box-shadow: var(--shadow-elevated);
}

/* ─────────────── 表单字段 ─────────────── */
.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-sm);
  font-weight: 500;
}

.form-input {
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) var(--spacing-md);
  font-size: 30rpx;
  background: var(--color-surface);
  transition: border-color var(--t-fast) var(--ease-out),
              box-shadow var(--t-fast) var(--ease-out);
  font-family: var(--font-sans);
}
.form-input:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3rpx var(--color-primary-light);
}

/* ─────────────── 价格/积分(粗体大字) ─────────────── */
.text-price {
  color: var(--color-price);
  font-weight: 800;
  font-family: var(--font-sans);
  font-variant-numeric: tabular-nums;
}
.text-points {
  color: var(--color-points);
  font-weight: 800;
  font-family: var(--font-sans);
  font-variant-numeric: tabular-nums;
}

/* ─────────────── 状态标签(pill) ─────────────── */
.status-tag {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-weight: 600;
  line-height: 1.4;
  font-family: var(--font-sans);
}
.status-tag--success { background: var(--color-success-light); color: var(--color-success); }
.status-tag--warning { background: var(--color-warning-light); color: var(--color-warning); }
.status-tag--danger  { background: var(--color-danger-light);  color: var(--color-danger); }
.status-tag--default { background: var(--color-surface); color: var(--color-text-secondary); }
.status-tag--info    { background: var(--color-primary-light); color: var(--color-primary); }

/* ─────────────── 列表中心 hero(骨架 B) ─────────────── */
.list-hero {
  background: var(--gradient-hero);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-elevated);
  color: var(--color-on-primary);
  position: relative;
  overflow: hidden;
}
.list-hero::after {
  content: "";
  position: absolute;
  top: -40rpx; right: -30rpx;
  width: 180rpx; height: 180rpx;
  border-radius: 50%;
  background: var(--color-on-primary);
  opacity: 0.10;
}
.list-hero__row {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}
.list-hero__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.list-hero__value {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-on-primary);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.list-hero__label {
  font-size: 22rpx;
  color: var(--color-on-primary);
  opacity: 0.8;
  letter-spacing: 0.5rpx;
}
.list-hero__divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.32);
  margin: 0 var(--spacing-md);
}

/* ── 列表信息卡(orders/transactions/usage-records 共用) ── */
.info-card {
  display: block;
}
.info-card__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-sm);
}
.info-card__id {
  font-size: 22rpx;
  color: var(--color-text-muted);
  font-family: var(--font-mono);
}
.info-card__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-xs);
}
.info-card__label {
  font-size: 28rpx;
  color: var(--color-text);
}
.info-card__amount {
  font-size: 30rpx;
  color: var(--color-accent-warm);
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.info-card__footer {
  display: flex;
  justify-content: space-between;
  margin-top: var(--spacing-xs);
  padding-top: var(--spacing-sm);
}
.info-card__time {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* ── 流水 delta chip(transactions) ── */
.tx-deltas {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 10rpx 0 6rpx;
}
.tx-delta-chip {
  display: inline-flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border-soft);
}
.tx-delta-chip--plus {
  background: var(--color-success-light);
  color: var(--color-success);
  border-color: transparent;
}
.tx-delta-chip--minus {
  background: var(--color-danger-light);
  color: var(--color-danger);
  border-color: transparent;
}

.tx-note {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  line-height: 1.5;
  padding-left: 4rpx;
}

/* ── 使用记录 app 标签 ── */
.info-card__app {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}
.info-card__cost {
  font-size: 26rpx;
  color: var(--color-accent-warm);
  font-weight: 800;
  font-family: var(--font-sans);
  font-variant-numeric: tabular-nums;
}
.info-card__cost--free {
  color: var(--color-success);
}
.info-card__error {
  margin-top: 8rpx;
  padding: 8rpx 14rpx;
  background: var(--color-danger-light);
  border-radius: var(--radius-sm);
  font-size: 23rpx;
  color: var(--color-danger);
  line-height: 1.4;
}

/* ─────────────── 状态文字 ─────────────── */
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-danger  { color: var(--color-danger); }
.text-muted   { color: var(--color-text-muted); }
.text-secondary { color: var(--color-text-secondary); }

/* ─────────────── 空状态 ─────────────── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx var(--spacing-lg);
}
.empty-state__icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-md);
}
.empty-state__icon-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--color-primary-bright);
  opacity: 0.5;
}
.empty-state__text {
  font-size: 28rpx;
  color: var(--color-text-muted);
  text-align: center;
}

/* ─────────────── 加载/错误状态 ─────────────── */
.loading-state {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-muted);
  text-align: center;
  padding: var(--spacing-lg);
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-lg);
}
.error-state__text {
  font-size: 28rpx;
  color: var(--color-danger);
  text-align: center;
  margin-bottom: var(--spacing-sm);
}

/* ─────────────── 列表行 ─────────────── */
.list-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.list-row:last-child { margin-bottom: 0; }

/* ─────────────── 加载更多 ─────────────── */
.load-more {
  text-align: center;
  padding: var(--spacing-md);
  cursor: pointer;
}
.load-more__text {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

/* ─────────────── 菜单列表 ─────────────── */
.menu-list {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border);
  overflow: hidden;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg);
  border-bottom: 1rpx solid var(--color-border-soft);
  transition: background var(--t-fast) var(--ease-out);
  position: relative;
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: var(--color-surface); }
.menu-item__left {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}
.menu-item__icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.menu-item__text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.menu-item__arrow {
  font-size: 32rpx;
  color: #C9C2DE;
  font-family: var(--font-sans);
}

/* ─────────────── 主操作按钮覆盖 ─────────────── */
button[type="primary"] {
  background: var(--gradient-primary) !important;
  border-radius: var(--radius-md) !important;
  border: none !important;
  box-shadow: 0 12rpx 32rpx rgba(124, 92, 252, 0.32) !important;
  font-family: var(--font-sans) !important;
  font-weight: 800;
  transition: transform var(--t-fast) var(--ease-out),
              box-shadow var(--t-fast) var(--ease-out) !important;
}
button[type="primary"]:active {
  opacity: 0.92;
  transform: scale(0.98);
}
button[type="primary"][disabled] {
  background: var(--color-border) !important;
  box-shadow: none !important;
  opacity: 0.7;
}

button[type="warn"] {
  background: var(--gradient-warm) !important;
  border-radius: var(--radius-md) !important;
  border: none !important;
  color: var(--color-on-primary) !important;
  font-weight: 800;
}

/* ─────────────── 分隔符(单色) ─────────────── */
.care-divider {
  height: 1rpx;
  margin: var(--spacing-lg) 0;
  background: var(--color-border-soft);
  border: none;
}

/* ─────────────── 统计块 ─────────────── */
.stat-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-block__value {
  font-family: var(--font-sans);
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}
.stat-block__label {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
  font-family: var(--font-sans);
}

/* ─────────────── CSS 应用图标符号 ─────────────── */
.app-icon-symbol {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-on-primary);
  flex-shrink: 0;
}
.app-icon-symbol--blue { background: var(--gradient-primary); }
.app-icon-symbol--teal { background: var(--gradient-brand-soft); }

/* ─────────────── CSS 图标系统(icon-tile) ───────────────
   v4.1:淡底 + 主色/主题色线条图标,不再使用彩色实底砖。 */
.icon-tile {
  --icon-line: var(--color-primary);
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-primary-light);
  transition: transform var(--t-base) var(--ease-out);
}
.icon-tile:active { transform: scale(0.94); }

.icon-tile::before,
.icon-tile::after,
.icon-tile__glyph::before,
.icon-tile__glyph::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}
.icon-tile::before,
.icon-tile::after { z-index: 1; }

.icon-tile__glyph {
  position: absolute;
  inset: 0;
  z-index: 1;
}

/* ── 尺寸 ── */
.icon-tile--sm  { width: 48rpx; height: 48rpx; border-radius: var(--radius-md); }
.icon-tile--app { width: 88rpx; height: 88rpx; border-radius: 24rpx; }

/* ── 配色(淡底 + 主题色线条) ── */
.icon-tile--blue    { background: var(--color-primary-light); --icon-line: var(--color-primary); }
.icon-tile--indigo  { background: #E4E1FB; --icon-line: #6A5FD8; }
.icon-tile--sky     { background: #DAEEFB; --icon-line: #2F7FC4; }
.icon-tile--teal    { background: var(--color-brand-soft-light); --icon-line: var(--color-brand-soft); }
.icon-tile--coral   { background: var(--color-accent-warm-light); --icon-line: var(--color-accent-warm); }
.icon-tile--peach   { background: var(--color-danger-light); --icon-line: var(--color-danger); }
.icon-tile--lavender{ background: var(--color-lavender-light); --icon-line: var(--color-lavender); }
.icon-tile--lemon   { background: var(--color-lemon-light); --icon-line: var(--color-lemon); }

/* ── 图标形状(几何,留用 v2 的 CSS-only 设计) ── */
.icon-tile--recharge::before {
  left: 20rpx; top: 24rpx;
  width: 42rpx; height: 30rpx;
  border: 5rpx solid var(--icon-line);
  border-radius: 9rpx;
}
.icon-tile--recharge::after {
  right: 18rpx; top: 32rpx;
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: var(--icon-line);
}

.icon-tile--orders::before {
  left: 23rpx; top: 16rpx;
  width: 34rpx; height: 48rpx;
  border-radius: 8rpx;
  background: var(--icon-line);
}
.icon-tile--orders::after {
  left: 31rpx; top: 29rpx;
  width: 18rpx; height: 4rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.85);
  box-shadow: 0 10rpx 0 rgba(255, 255, 255, 0.75), 0 20rpx 0 rgba(255, 255, 255, 0.65);
}

.icon-tile--transactions::before {
  left: 18rpx; top: 24rpx;
  width: 44rpx; height: 28rpx;
  border-left: 5rpx solid var(--icon-line);
  border-bottom: 5rpx solid var(--icon-line);
  border-radius: 0 0 0 16rpx;
}
.icon-tile--transactions::after {
  right: 15rpx; top: 18rpx;
  width: 16rpx; height: 16rpx;
  border-top: 5rpx solid var(--icon-line);
  border-right: 5rpx solid var(--icon-line);
  transform: rotate(45deg);
}

.icon-tile--records::before {
  left: 23rpx; top: 17rpx;
  width: 34rpx; height: 46rpx;
  border: 5rpx solid var(--icon-line);
  border-radius: 8rpx;
}
.icon-tile--records::after {
  left: 31rpx; top: 12rpx;
  width: 18rpx; height: 10rpx;
  border-radius: 6rpx;
  background: var(--icon-line);
  box-shadow: 0 30rpx 0 -3rpx var(--icon-line), 0 42rpx 0 -3rpx var(--icon-line);
}

.icon-tile--calculator::before {
  left: 20rpx; top: 14rpx;
  width: 40rpx; height: 52rpx;
  border: 5rpx solid var(--icon-line);
  border-radius: 10rpx;
}
.icon-tile--calculator::after {
  left: 29rpx; top: 24rpx;
  width: 22rpx; height: 7rpx;
  border-radius: 4rpx;
  background: var(--icon-line);
  box-shadow: 0 17rpx 0 -1rpx var(--icon-line), 0 30rpx 0 -1rpx var(--icon-line);
}

.icon-tile--image::before {
  left: 17rpx; top: 18rpx;
  width: 46rpx; height: 42rpx;
  border: 5rpx solid var(--icon-line);
  border-radius: 10rpx;
}
.icon-tile--image::after {
  left: 26rpx; top: 42rpx;
  width: 30rpx; height: 18rpx;
  background: var(--icon-line);
  clip-path: polygon(0 100%, 38% 26%, 58% 58%, 74% 36%, 100% 100%);
}
.icon-tile--image .icon-tile__glyph::before {
  right: 24rpx; top: 26rpx;
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: var(--icon-line);
}

.icon-tile--toolbox::before {
  left: 16rpx; top: 27rpx;
  width: 48rpx; height: 34rpx;
  border: 5rpx solid var(--icon-line);
  border-radius: 8rpx;
}
.icon-tile--toolbox::after {
  left: 29rpx; top: 17rpx;
  width: 22rpx; height: 16rpx;
  border: 5rpx solid var(--icon-line);
  border-bottom: none;
  border-radius: 9rpx 9rpx 0 0;
}

/* undercover: 放大镜+问号(语义"找卧底") */
.icon-tile--undercover::before {
  left: 18rpx; top: 16rpx;
  width: 34rpx; height: 34rpx;
  border: 5rpx solid var(--icon-line);
  border-radius: 50%;
}
.icon-tile--undercover::after {
  left: 48rpx; top: 48rpx;
  width: 18rpx; height: 5rpx;
  background: var(--icon-line);
  border-radius: var(--radius-pill);
  transform: rotate(45deg);
}
.icon-tile--undercover .icon-tile__glyph::before {
  left: 31rpx; top: 24rpx;
  width: 8rpx; height: 14rpx;
  border-top: 5rpx solid var(--icon-line);
  border-right: 5rpx solid var(--icon-line);
  border-radius: 0 8rpx 0 0;
}
.icon-tile--undercover .icon-tile__glyph::after {
  left: 33rpx; top: 42rpx;
  width: 5rpx; height: 5rpx;
  border-radius: 50%;
  background: var(--icon-line);
}
