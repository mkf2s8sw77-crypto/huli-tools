/* 沪里工具设计系统 v2 Token — 所有页面和组件通过 @import 引用此文件 */

page {
  /* ── 主色系 ── */
  --color-primary: #1e5a8c;
  --color-primary-hover: #174a74;
  --color-primary-bright: #2a7ab5;
  --color-primary-light: #e6f0f8;
  --color-on-primary: #ffffff;

  /* ── 品牌辅助色 ── */
  --color-brand-soft: #5ba8a0;
  --color-brand-soft-bright: #6dbfb5;
  --color-brand-soft-light: #eaf5f3;
  --color-accent-warm: #c4963a;
  --color-accent-warm-bright: #d4a85a;
  --color-accent-warm-light: #fef8ec;

  /* ── 状态色 ── */
  --color-success: #2e8b6a;
  --color-success-light: #e6f5ee;
  --color-warning: #c4963a;
  --color-warning-light: #fef8ec;
  --color-danger: #c0392b;
  --color-danger-light: #fdf0ee;

  /* ── 文字 ── */
  --color-text: #1a2a3a;
  --color-text-secondary: #5a6a7a;
  --color-text-muted: #8a96a4;

  /* ── 表面系统 ── */
  --color-bg: #f0f3f7;
  --color-surface: #f4f6f9;
  --color-surface-elevated: #ffffff;
  --color-bg-card: #ffffff;
  --color-border: #e2e8f0;
  --color-border-soft: #edf1f5;

  /* ── 语义色 ── */
  --color-price: #c4963a;
  --color-points: #1e5a8c;

  /* ── 圆角 ── */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 20rpx;
  --radius-xl: 28rpx;
  --radius-pill: 999rpx;

  /* ── 阴影 ── */
  --shadow-soft: 0 2rpx 16rpx rgba(30, 90, 140, 0.06), 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
  --shadow-card: 0 4rpx 24rpx rgba(30, 90, 140, 0.07), 0 1rpx 6rpx rgba(0, 0, 0, 0.03);
  --shadow-elevated: 0 8rpx 40rpx rgba(30, 90, 140, 0.1), 0 2rpx 8rpx rgba(0, 0, 0, 0.04);

  /* ── 间距 ── */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* ── 页面渐变 ── */
  --page-gradient: linear-gradient(180deg, #e4ecf4 0%, #f0f3f7 320rpx, #f4f6f9 100%);
  --gradient-primary: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-bright) 100%);
  --gradient-hero: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-bright) 60%, var(--color-brand-soft) 100%);
  --gradient-brand-soft: linear-gradient(135deg, var(--color-brand-soft) 0%, var(--color-brand-soft-bright) 100%);
  --gradient-warm: linear-gradient(135deg, var(--color-accent-warm) 0%, var(--color-accent-warm-bright) 100%);

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  background: var(--page-gradient);
  color: var(--color-text);
}
