/* 我的页面私有样式 */

.value {
  display: block;
  font-size: 32rpx;
  color: var(--color-text);
  font-weight: 500;
  font-family: monospace;
}

.points-card {
  text-align: center;
}

.points-card .form-label {
  text-align: center;
}

.points-sub {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.frozen {
  display: block;
  font-size: 26rpx;
  color: var(--color-warning);
}

.sub {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
}
