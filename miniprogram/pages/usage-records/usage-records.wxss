@import "../../app.wxss";

.header {
  margin-bottom: 48rpx;
  text-align: center;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.loading {
  display: block;
  font-size: 28rpx;
  color: #999;
  text-align: center;
}

.empty {
  display: block;
  font-size: 28rpx;
  color: #999;
  text-align: center;
}

.record-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.record-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.record-row:last-child {
  margin-bottom: 0;
}

.record-app {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.record-status {
  font-size: 24rpx;
  font-weight: 500;
}

.record-cost {
  font-size: 26rpx;
  color: #666;
}

.record-error {
  font-size: 24rpx;
  color: #fa5151;
}

.record-time {
  font-size: 22rpx;
  color: #999;
}

.load-more {
  text-align: center;
  padding: 24rpx;
}

.load-more-text {
  font-size: 26rpx;
  color: #999;
}
