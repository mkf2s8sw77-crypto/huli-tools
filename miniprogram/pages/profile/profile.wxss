/* 我的页面 v4.1 — 账户中心 */

/* ── 顶栏:品牌 ── */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
}
.brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.brand__logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(124, 92, 252, 0.35);
}
.brand__name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: 0.5rpx;
}

/* ── 账户 hero(紫色渐变) ── */
.acct-hero {
  background: var(--gradient-hero);
  border-radius: 48rpx;
  padding: 52rpx;
  color: var(--color-on-primary);
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-elevated);
  margin-bottom: var(--spacing-md);
}
.acct-hero::before {
  content: "";
  position: absolute;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  right: -120rpx;
  top: -160rpx;
}
.acct-hero__row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  position: relative;
}
.acct-hero__main {
  display: flex;
  flex-direction: column;
}
.acct-hero__label {
  font-size: 26rpx;
  opacity: 0.85;
}
.acct-hero__num {
  font-size: 88rpx;
  font-weight: 800;
  margin-top: 12rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
  line-height: 1.05;
}
.acct-hero__btn {
  background: #ffffff;
  color: var(--color-primary-hover);
  font-size: 28rpx;
  font-weight: 800;
  padding: 20rpx 44rpx;
  border-radius: var(--radius-pill);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  position: relative;
  transition: transform var(--t-fast) var(--ease-out);
}
.acct-hero__btn:active {
  transform: scale(0.94);
}
.acct-hero__sub {
  display: flex;
  gap: 56rpx;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
  position: relative;
}
.acct-hero__sub-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.acct-hero__sub-label {
  font-size: 24rpx;
  opacity: 0.85;
}
.acct-hero__sub-num {
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

/* ── 身份栏 ── */
.id-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-card);
}
.id-bar__logo {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
}
.id-bar__text {
  font-size: 26rpx;
  color: var(--color-text-muted);
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}
