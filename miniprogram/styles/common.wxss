/* huli-tools 设计系统 — 柔彩多巴胺通用样式 */
@import "./tokens.wxss";

/* ── 页面容器 ── */
.container {
  padding: var(--spacing-lg);
}

/* ── 页面头部 ── */
.page-header {
  margin-bottom: var(--spacing-lg);
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 0;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: var(--spacing-xs);
}

.page-eyebrow {
  display: block;
  font-size: 22rpx;
  color: var(--color-brand-soft);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0;
  margin-bottom: 4rpx;
}

/* ── 区域标题 ── */
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.35;
  margin: 4rpx 0 22rpx;
  padding-left: 26rpx;
  position: relative;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 8rpx;
  border-radius: var(--radius-pill);
  background: var(--gradient-hero);
}

/* ── 卡片 ── */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border-soft);
  position: relative;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: var(--gradient-hero);
  opacity: 0.4;
}

.card--elevated {
  box-shadow: var(--shadow-elevated);
  border-color: var(--color-border);
}

.card--soft {
  background: var(--color-lavender-light);
  border-color: var(--color-border-soft);
}

.card--hero {
  background: var(--gradient-primary);
  color: var(--color-on-primary);
  border: none;
}

.card--hero::before {
  display: none;
}

/* ── 表单字段 ── */
.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-sm);
  font-weight: 500;
}

.form-input {
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm);
  font-size: 30rpx;
  background: var(--color-surface);
  transition: border-color 0.2s;
}

.form-input:focus {
  border-color: var(--color-primary);
}

/* ── 价格/积分 ── */
.text-price {
  color: var(--color-price);
  font-weight: 600;
}

.text-points {
  color: var(--color-points);
  font-weight: 600;
}

/* ── 状态标签 ── */
.status-tag {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
  line-height: 1.4;
}

.status-tag--success {
  background: var(--color-success-light);
  color: var(--color-success);
}

.status-tag--warning {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

.status-tag--danger {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

.status-tag--default {
  background: var(--color-surface);
  color: var(--color-text-secondary);
}

.status-tag--info {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

/* ── 状态文字 ── */
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-danger { color: var(--color-danger); }
.text-muted { color: var(--color-text-muted); }
.text-secondary { color: var(--color-text-secondary); }

/* ── 空状态 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx var(--spacing-lg);
}

.empty-state__icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-lavender-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-md);
}

.empty-state__icon-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--color-lavender);
  opacity: 0.5;
}

.empty-state__text {
  font-size: 28rpx;
  color: var(--color-text-muted);
  text-align: center;
}

/* ── 加载中 ── */
.loading-state {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-muted);
  text-align: center;
  padding: var(--spacing-lg);
}

/* ── 错误状态 ── */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-lg);
}

.error-state__text {
  font-size: 28rpx;
  color: var(--color-danger);
  text-align: center;
  margin-bottom: var(--spacing-sm);
}

/* ── 列表行 ── */
.list-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.list-row:last-child {
  margin-bottom: 0;
}

/* ── 加载更多 ── */
.load-more {
  text-align: center;
  padding: var(--spacing-md);
}

.load-more__text {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

/* ── 菜单列表 ── */
.menu-list {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border-soft);
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg);
  border-bottom: 1rpx solid var(--color-border-soft);
  transition: background 0.15s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--color-surface);
}

.menu-item__left {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.menu-item__icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.menu-item__text {
  font-size: 30rpx;
  color: var(--color-text);
}

.menu-item__arrow {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* ── 主操作按钮覆盖 ── */
button[type="primary"] {
  background: var(--gradient-primary) !important;
  border-radius: var(--radius-md) !important;
  border: none !important;
  box-shadow: var(--shadow-soft) !important;
}

button[type="primary"]:active {
  opacity: 0.85;
}

button[type="primary"][disabled] {
  background: var(--color-border) !important;
  box-shadow: none !important;
}

/* ── 护理线分隔符 ── */
.care-divider {
  height: 2rpx;
  margin: var(--spacing-lg) 0;
  background: linear-gradient(90deg, transparent, var(--color-peach-light), var(--color-peach), var(--color-lavender), var(--color-lavender-light), transparent);
  border: none;
}

/* ── 统计块 ── */
.stat-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-block__value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.2;
}

.stat-block__label {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

/* ── CSS 应用图标符号 ── */
.app-icon-symbol {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-on-primary);
  flex-shrink: 0;
}

.app-icon-symbol--blue {
  background: var(--gradient-primary);
}

.app-icon-symbol--teal {
  background: var(--gradient-brand-soft);
}

.app-icon-symbol--gold {
  background: var(--gradient-warm);
}

.app-icon-symbol--coral {
  background: var(--gradient-warm);
}

.app-icon-symbol--peach {
  background: var(--gradient-peach);
}

.app-icon-symbol--lavender {
  background: var(--gradient-lavender);
}

.app-icon-symbol--lemon {
  background: var(--gradient-lemon);
  color: var(--color-text);
}

/* ── CSS 图标系统：不要再用单字代替图标 ── */
.icon-tile {
  --icon-line: var(--color-on-primary);
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: var(--shadow-soft);
}

.icon-tile::before,
.icon-tile::after,
.icon-tile__glyph::before,
.icon-tile__glyph::after {
  content: '';
  position: absolute;
  box-sizing: border-box;
}

.icon-tile::before,
.icon-tile::after {
  z-index: 1;
}

.icon-tile__glyph {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.icon-tile--sm {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-md);
}

.icon-tile--app {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
}

.icon-tile--blue { background: var(--gradient-primary); }
.icon-tile--teal { background: var(--gradient-brand-soft); }
.icon-tile--coral { background: var(--gradient-warm); }
.icon-tile--peach { background: var(--gradient-peach); }
.icon-tile--lavender { background: var(--gradient-lavender); }
.icon-tile--lemon {
  background: var(--gradient-lemon);
  --icon-line: var(--color-text);
}

.icon-tile--recharge::before {
  left: 20rpx;
  top: 24rpx;
  width: 42rpx;
  height: 30rpx;
  border: 5rpx solid var(--icon-line);
  border-radius: 9rpx;
}

.icon-tile--recharge::after {
  right: 18rpx;
  top: 32rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--icon-line);
}

.icon-tile--orders::before {
  left: 23rpx;
  top: 16rpx;
  width: 34rpx;
  height: 48rpx;
  border-radius: 8rpx;
  background: var(--icon-line);
}

.icon-tile--orders::after {
  left: 31rpx;
  top: 29rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: var(--radius-pill);
  background: rgba(45, 55, 72, 0.32);
  box-shadow: 0 10rpx 0 rgba(45, 55, 72, 0.28), 0 20rpx 0 rgba(45, 55, 72, 0.22);
}

.icon-tile--transactions::before {
  left: 18rpx;
  top: 24rpx;
  width: 44rpx;
  height: 28rpx;
  border-left: 5rpx solid var(--icon-line);
  border-bottom: 5rpx solid var(--icon-line);
  border-radius: 0 0 0 16rpx;
}

.icon-tile--transactions::after {
  right: 15rpx;
  top: 18rpx;
  width: 16rpx;
  height: 16rpx;
  border-top: 5rpx solid var(--icon-line);
  border-right: 5rpx solid var(--icon-line);
  transform: rotate(45deg);
}

.icon-tile--records::before {
  left: 23rpx;
  top: 17rpx;
  width: 34rpx;
  height: 46rpx;
  border: 5rpx solid var(--icon-line);
  border-radius: 8rpx;
}

.icon-tile--records::after {
  left: 31rpx;
  top: 12rpx;
  width: 18rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: var(--icon-line);
  box-shadow: 0 30rpx 0 -3rpx var(--icon-line), 0 42rpx 0 -3rpx var(--icon-line);
}

.icon-tile--calculator::before {
  left: 20rpx;
  top: 14rpx;
  width: 40rpx;
  height: 52rpx;
  border: 5rpx solid var(--icon-line);
  border-radius: 10rpx;
}

.icon-tile--calculator::after {
  left: 29rpx;
  top: 24rpx;
  width: 22rpx;
  height: 7rpx;
  border-radius: 4rpx;
  background: var(--icon-line);
  box-shadow: 0 17rpx 0 -1rpx var(--icon-line), 0 30rpx 0 -1rpx var(--icon-line);
}

.icon-tile--image::before {
  left: 17rpx;
  top: 18rpx;
  width: 46rpx;
  height: 42rpx;
  border: 5rpx solid var(--icon-line);
  border-radius: 10rpx;
}

.icon-tile--image::after {
  left: 26rpx;
  top: 42rpx;
  width: 30rpx;
  height: 18rpx;
  background: var(--icon-line);
  clip-path: polygon(0 100%, 38% 26%, 58% 58%, 74% 36%, 100% 100%);
}

.icon-tile--image .icon-tile__glyph::before {
  right: 24rpx;
  top: 26rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--icon-line);
}

.icon-tile--toolbox::before {
  left: 16rpx;
  top: 27rpx;
  width: 48rpx;
  height: 34rpx;
  border: 5rpx solid var(--icon-line);
  border-radius: 8rpx;
}

.icon-tile--toolbox::after {
  left: 29rpx;
  top: 17rpx;
  width: 22rpx;
  height: 16rpx;
  border: 5rpx solid var(--icon-line);
  border-bottom: none;
  border-radius: 9rpx 9rpx 0 0;
}
