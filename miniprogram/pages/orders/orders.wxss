/* 订单页私有样式 */

.order-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.order-no {
  font-size: 24rpx;
  color: var(--color-text-muted);
  font-family: monospace;
}

.order-package {
  font-size: 28rpx;
  color: var(--color-text);
}

.order-amount {
  font-size: 28rpx;
  color: var(--color-price);
  font-weight: 500;
}

.order-points {
  font-size: 26rpx;
  color: var(--color-points);
}

.order-time,
.order-paid {
  font-size: 22rpx;
  color: var(--color-text-muted);
}
