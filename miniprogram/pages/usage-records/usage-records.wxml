<ui-page title="使用记录" subtitle="应用调用历史与积分消耗">
  <view wx:if="{{loading && list.length === 0}}">
    <ui-card>
      <text class="loading-state">正在加载...</text>
    </ui-card>
  </view>

  <view wx:elif="{{list.length === 0}}">
    <ui-empty text="暂无使用记录" />
  </view>

  <view wx:else>
    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="card info-card"
    >
      <view class="info-card__top">
        <text class="info-card__app">{{item.appKey}}</text>
        <ui-status text="{{item.statusText}}" type="{{item.statusType}}" />
      </view>
      <view class="info-card__row">
        <text class="info-card__label">积分消耗</text>
        <text wx:if="{{item.costPoints > 0}}" class="info-card__cost">{{item.costPoints}} 积分</text>
        <text wx:else class="info-card__cost info-card__cost--free">免费</text>
      </view>
      <view wx:if="{{item.errorMessage}}" class="info-card__error">
        <text>{{item.errorMessage}}</text>
      </view>
      <view class="info-card__footer">
        <text class="info-card__time">{{item.startedAtText}}</text>
        <text wx:if="{{item.finishedAtText !== '-'}}" class="info-card__time">完成于 {{item.finishedAtText}}</text>
      </view>
    </view>

    <view wx:if="{{hasMore}}" class="load-more" bindtap="onReachBottom">
      <text class="load-more__text">加载更多...</text>
    </view>
    <view wx:elif="{{list.length > 0}}" class="load-more">
      <text class="load-more__text">没有更多记录了</text>
    </view>
  </view>
</ui-page>
