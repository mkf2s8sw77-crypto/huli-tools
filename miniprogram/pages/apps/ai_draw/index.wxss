/* 护士职业定妆照 — 应用执行页 */

page {
  /* 给底部固定操作栏留出占位空间 */
  padding-bottom: 220rpx;
}

.app-exec-header {
  margin-bottom: 34rpx;
  padding: 34rpx;
  border-radius: var(--radius-xl);
  background: var(--gradient-hero);
  box-shadow: var(--shadow-elevated);
  position: relative;
  overflow: hidden;
}

.app-exec-header::after {
  content: '';
  position: absolute;
  right: -42rpx;
  top: -54rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: var(--radius-pill);
  background: var(--color-on-primary);
  opacity: 0.14;
}

.app-exec-header__row {
  display: flex;
  align-items: center;
  gap: 26rpx;
  position: relative;
  z-index: 1;
}

.app-exec-header__info {
  display: flex;
  flex-direction: column;
}

.app-exec-header__name {
  font-family: var(--font-sans);
  font-size: 38rpx;
  font-weight: 600;
  color: var(--color-on-primary);
  line-height: 1.25;
}

.app-exec-header__cost {
  align-self: flex-start;
  font-size: 25rpx;
  color: var(--color-accent-warm);
  background: var(--color-bg-card);
  border-radius: var(--radius-pill);
  padding: 7rpx 18rpx;
  font-weight: 600;
  margin-top: 10rpx;
  font-variant-numeric: tabular-nums;
}

.app-exec-header .icon-tile {
  background: var(--color-primary-light);
  border: 2rpx solid var(--color-bg-card);
  box-shadow: none;
  --icon-line: var(--color-primary);
}

.subject-preview {
  display: grid;
  grid-template-columns: 132rpx 1fr auto;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface-elevated);
}

.subject-preview__image {
  width: 132rpx;
  height: 132rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

.subject-preview__body {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.subject-preview__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.25;
}

.subject-preview__desc {
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.3;
  word-break: break-all;
}

.asset-upload {
  width: 100%;
  min-height: 132rpx;
  border-radius: var(--radius-lg);
  border: 2rpx dashed var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-light);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.asset-upload--primary {
  border-color: var(--color-brand-soft);
  color: var(--color-brand-soft);
  background: var(--color-brand-soft-light);
}

.asset-remove {
  color: var(--color-danger);
  background: var(--color-danger-light);
  border-radius: var(--radius-pill);
}

.reference-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.reference-item,
.reference-add {
  height: 152rpx;
  border-radius: var(--radius-md);
  position: relative;
  overflow: hidden;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
}

.reference-item__image {
  width: 100%;
  height: 100%;
}

.reference-item__remove {
  position: absolute;
  right: 4rpx;
  top: 4rpx;
  width: 42rpx;
  height: 42rpx;
  min-height: 42rpx;
  line-height: 42rpx;
  padding: 0;
  border-radius: var(--radius-pill);
  color: var(--color-on-primary);
  background: var(--color-danger);
  font-size: 28rpx;
}

.reference-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  border: 2rpx dashed var(--color-primary);
  background: var(--color-primary-light);
  padding: 0;
}

.reference-add__badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-pill);
  background: var(--color-bg-card);
  position: relative;
}

.reference-add__badge::before,
.reference-add__badge::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  background: var(--color-primary);
  border-radius: 4rpx;
}

.reference-add__badge::before {
  width: 26rpx;
  height: 4rpx;
  transform: translate(-50%, -50%);
}

.reference-add__badge::after {
  width: 4rpx;
  height: 26rpx;
  transform: translate(-50%, -50%);
}

/* 空状态:整行宽虚线添加卡 */
.reference-add-empty {
  width: 100%;
  min-height: 152rpx;
  border-radius: var(--radius-lg);
  border: 2rpx dashed var(--color-primary);
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 24rpx;
  line-height: 1.3;
}

.reference-add-empty__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  border: 3rpx solid var(--color-primary);
  position: relative;
  flex: none;
  box-sizing: border-box;
}

/* CSS-only 图片图标:山形 + 太阳 */
.reference-add-empty__icon::before {
  content: "";
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  bottom: 10rpx;
  height: 22rpx;
  background: var(--color-primary);
  clip-path: polygon(0 100%, 32% 32%, 52% 68%, 70% 40%, 100% 100%);
}

.reference-add-empty__icon::after {
  content: "";
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.reference-add-empty__texts {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.reference-add-empty__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.reference-add-empty__desc {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.field-hint {
  display: block;
  font-size: 23rpx;
  color: var(--color-text-muted);
  line-height: 1.35;
  margin-top: var(--spacing-sm);
}

.composition-group {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.composition-option {
  min-width: 0;
  padding: 18rpx 14rpx;
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface-elevated);
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.composition-option--active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.composition-option radio {
  transform: scale(0.78);
  margin-top: 2rpx;
}

.composition-option__text {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.composition-option__label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.2;
}

.composition-option__desc {
  font-size: 21rpx;
  color: var(--color-text-muted);
  line-height: 1.25;
}

.requirements-input {
  width: 100%;
  min-height: 136rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  font-size: 29rpx;
  line-height: 1.45;
  box-sizing: border-box;
  background: var(--color-surface-elevated);
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: var(--spacing-xs);
}

.app-exec-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -8rpx 24rpx rgba(24, 20, 42, 0.06);
  margin: 0;
}

.app-exec-actions ui-action-button {
  flex: 1;
}

.app-exec-btn {
  width: 100%;
}

/* 固定底栏内 disabled 也保持可读:淡紫底 + 紫字 */
.app-exec-btn.ui-action-btn--disabled {
  opacity: 1;
  background: var(--color-primary-light) !important;
  color: var(--color-primary) !important;
  box-shadow: none !important;
}

.app-exec-cancel {
  margin-top: 0;
  flex: none;
}

.app-exec-task {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx;
  margin-bottom: var(--spacing-md);
}

.app-exec-task__spinner {
  width: 42rpx;
  height: 42rpx;
  border-radius: var(--radius-pill);
  border: 5rpx solid var(--color-primary-light);
  border-top-color: var(--color-primary);
  animation: app-exec-spin 0.9s linear infinite;
  flex-shrink: 0;
}

.app-exec-task__body {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.app-exec-task__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.35;
}

.app-exec-task__desc {
  font-size: 23rpx;
  color: var(--color-text-muted);
  line-height: 1.35;
}

@keyframes app-exec-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.app-exec-result {
  text-align: center;
  padding: var(--spacing-lg);
  background: var(--color-bg-card);
}

.app-exec-result__label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: var(--spacing-sm);
}

.result-image {
  width: 100%;
  max-height: 800rpx;
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-md);
  background: var(--color-surface);
}

.save-btn {
  margin-top: var(--spacing-sm);
  border-radius: var(--radius-md) !important;
}

.app-exec-error {
  background: var(--color-danger-light);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-top: var(--spacing-md);
  text-align: center;
}

.app-exec-error text {
  font-size: 28rpx;
  color: var(--color-danger);
}
