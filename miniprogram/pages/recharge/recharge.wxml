<ui-page title="积分充值">
  <view wx:if="{{loading}}">
    <ui-card>
      <text class="loading-state">正在加载充值包...</text>
    </ui-card>
  </view>

  <view wx:elif="{{packages.length === 0}}">
    <ui-empty text="暂无充值包" />
  </view>

  <view wx:else>
    <view
      wx:for="{{packages}}"
      wx:key="packageKey"
      class="package-card"
    >
      <view class="package-header">
        <text class="package-name">{{item.name}}</text>
        <text class="package-price">{{item.amountYuan}} 元</text>
      </view>
      <view class="package-body">
        <text class="package-points">基础积分: {{item.basePoints}}</text>
        <text wx:if="{{item.bonusPoints > 0}}" class="package-bonus">赠送积分: {{item.bonusPoints}}</text>
        <text class="package-total">到账总计: {{item.basePoints + item.bonusPoints}} 积分</text>
      </view>
      <button
        type="primary"
        size="mini"
        loading="{{creating}}"
        disabled="{{creating}}"
        data-pkg="{{item}}"
        bindtap="onCreateOrder"
      >创建订单</button>
    </view>
  </view>

  <view wx:if="{{payingOrderNo}}" class="card mock-card">
    <text class="form-label">模拟支付（开发/测试）</text>
    <text class="subvalue">订单号: {{payingOrderNo}}</text>
    <button
      type="warn"
      size="mini"
      loading="{{paying}}"
      disabled="{{paying}}"
      bindtap="onMockPay"
    >模拟支付到账</button>
  </view>

  <view class="card link-card" bindtap="onGoOrders">
    <text class="link-text">查看我的订单 ></text>
  </view>
</ui-page>
