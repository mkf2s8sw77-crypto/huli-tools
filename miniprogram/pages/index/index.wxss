/* 首页私有样式 — 通用样式由 app.wxss 提供 */

.app-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.app-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.app-badge {
  font-size: 22rpx;
  color: var(--color-warning);
  background: var(--color-warning-light);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.app-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.app-footer {
  display: flex;
  justify-content: flex-end;
}

.app-price {
  font-size: 24rpx;
  color: var(--color-points);
}
