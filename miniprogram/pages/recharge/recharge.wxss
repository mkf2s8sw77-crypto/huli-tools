/* 充值页 v2 */

.pkg-card__header {
  margin-bottom: 0;
}

.pkg-card__title {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.pkg-card__name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.pkg-card__price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-accent-warm);
}

.pkg-card__body {
  margin-bottom: var(--spacing-md);
}

.pkg-card__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-xs);
}

.pkg-card__row--total {
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-border-soft);
}

.pkg-card__label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.pkg-card__val {
  font-size: 26rpx;
  color: var(--color-text);
}

.pkg-card__val--bonus {
  color: var(--color-success);
  font-weight: 500;
}

.pkg-card__btn {
  width: 100%;
}

/* ── 模拟支付 ── */
.mock-card {
  border: 2rpx dashed var(--color-warning);
  background: var(--color-warning-light);
}

.mock-card::before {
  display: none;
}

.mock-card__order {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: var(--spacing-sm);
  font-family: monospace;
}

/* ── 链接卡 ── */
.link-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.link-card__text {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
}
