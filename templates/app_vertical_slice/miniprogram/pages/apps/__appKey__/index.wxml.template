<ui-page title="__appName__">
  <!-- TODO: 添加业务表单 -->
  <ui-form-field label="请输入参数">
    <input class="form-input" placeholder="参数值" />
  </ui-form-field>

  <button
    type="primary"
    bindtap="onExecute"
    disabled="{{loading}}"
    loading="{{loading}}"
  >
    执行
  </button>

  <ui-card wx:if="{{result}}" extraClass="result-section">
    <text class="form-label">结果：</text>
    <text class="result-value">{{result}}</text>
  </ui-card>

  <view wx:if="{{errorMsg}}" class="error-section">
    <text class="error-text">{{errorMsg}}</text>
  </view>
</ui-page>
