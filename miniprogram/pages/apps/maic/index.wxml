<ui-page variant="dashboard">
  <view class="maic-brand fade-in">
    <view class="maic-brand__identity">
      <view class="maic-brand__mark"><text>M</text></view>
      <view>
        <text class="maic-brand__name">MAIC</text>
        <text class="maic-brand__caption">智慧课堂</text>
      </view>
    </view>
    <text class="maic-free-badge">限时免费生成</text>
  </view>

  <view class="maic-workbench fade-in fade-in-1">
    <view class="maic-workbench__glow maic-workbench__glow--one"></view>
    <view class="maic-workbench__glow maic-workbench__glow--two"></view>
    <view class="maic-workbench__content">
      <text class="maic-workbench__eyebrow">AI 课程工作台</text>
      <text class="maic-workbench__title">今天想创建什么课程？</text>
      <text class="maic-workbench__desc">描述课堂主题和目标，MAIC 会把它编排成原生互动课程。</text>

      <view class="maic-composer">
        <textarea class="maic-composer__topic" value="{{topic}}" maxlength="500" auto-height placeholder="例如：为护理实习生设计一门输液反应识别课……" bindinput="onTopicInput" />

        <view class="maic-toolbar">
          <view class="maic-toolbar__field maic-toolbar__field--grow">
            <text class="maic-toolbar__label">学习对象</text>
            <input class="maic-toolbar__input" value="{{audience}}" maxlength="200" placeholder="选填，如护理实习生" bindinput="onAudienceInput" />
          </view>
          <picker class="maic-toolbar__picker" range="{{durationOptions}}" value="{{durationIndex}}" bindchange="onDurationPickerChange">
            <view class="maic-toolbar__field">
              <text class="maic-toolbar__label">课程时长</text>
              <text class="maic-toolbar__value">{{durationMinutes}} 分钟 ›</text>
            </view>
          </picker>
        </view>

        <textarea class="maic-composer__requirements" value="{{requirements}}" maxlength="3000" auto-height placeholder="补充要求（选填）：案例、难度、教学重点……" bindinput="onRequirementsInput" />

        <view class="maic-composer__footer">
          <text class="maic-composer__meta">MiniMax M2.7 · 原生互动 · 云端续学</text>
          <ui-action-button extra-class="maic-submit" text="{{loading ? '正在提交…' : '进入智慧课堂'}}" loading="{{loading}}" disabled="{{loading || topic.length < 2 || (appInfo && appInfo.status !== 'active')}}" bind:tap="createCourse" />
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{appInfo && appInfo.status !== 'active'}}" class="maic-notice">
    当前应用仍处于开发验收状态；免费策略已生效，激活后即可生成课程。
  </view>

  <view wx:if="{{activeUsageId}}" class="maic-active-task tap-feedback" bindtap="resumeTask">
    <view>
      <text class="maic-active-task__title">有一门课程正在生成</text>
      <text class="maic-active-task__desc">点此查看进度，退出小程序也不会中断</text>
    </view>
    <text class="maic-link">查看</text>
  </view>

  <view class="maic-recent fade-in fade-in-2">
    <view class="maic-recent__heading">
      <view class="maic-recent__line"></view>
      <text>最近课堂</text>
      <text class="maic-recent__count">{{courses.length}}</text>
      <view class="maic-recent__line"></view>
    </view>
    <view wx:if="{{coursesLoading}}" class="maic-loading">正在加载课程…</view>
    <ui-empty wx:elif="{{empty}}" text="还没有课程，生成后会保存在这里" />
    <view wx:else class="maic-course-grid">
      <view wx:for="{{courses}}" wx:key="courseId" class="maic-course-card tap-feedback" data-id="{{item.courseId}}" bindtap="openCourse">
        <view class="maic-course-card__cover">
          <text class="maic-course-card__index">{{item.displayIndex}}</text>
          <view class="maic-course-card__orbit"></view>
          <text class="maic-course-card__scenes">{{item.sceneCount}} 个场景</text>
        </view>
        <text class="maic-course-card__title">{{item.title}}</text>
        <text class="maic-course-card__summary">{{item.summary}}</text>
        <text class="maic-course-card__date">{{item.displayDate}}</text>
      </view>
    </view>
  </view>
</ui-page>
