<ui-page title="{{appInfo ? appInfo.name : '积分示例工具'}}" subtitle="演示积分扣费链路">
  <ui-card wx:if="{{appInfo && appInfo.pricing && appInfo.pricing.mode === 'fixed'}}">
    <text class="form-label">本次消耗</text>
    <text class="cost-points">{{appInfo.pricing.costPoints}} 积分</text>
  </ui-card>

  <ui-form-field label="数字 A">
    <input type="number" value="{{a}}" bindinput="onInputA" placeholder="请输入数字" class="form-input" />
  </ui-form-field>

  <ui-form-field label="数字 B">
    <input type="number" value="{{b}}" bindinput="onInputB" placeholder="请输入数字" class="form-input" />
  </ui-form-field>

  <ui-card>
    <switch checked="{{triggerFail}}" bindchange="onToggleFail" />
    <text class="form-label" style="display:inline;margin-left:20rpx;">模拟业务失败（测试释放积分）</text>
  </ui-card>

  <button type="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onCalc">计算求和</button>

  <ui-card wx:if="{{usageId}}">
    <text class="form-label">使用记录 ID</text>
    <text class="subvalue">{{usageId}}</text>
    <text wx:if="{{costPoints > 0}}" class="subvalue">消耗 {{costPoints}} 积分</text>
  </ui-card>

  <ui-card wx:if="{{result !== null}}" extraClass="result">
    <text class="form-label">结果</text>
    <text class="value">{{result}}</text>
  </ui-card>

  <view wx:if="{{error}}" class="error-card">
    <text>{{error}}</text>
  </view>
</ui-page>
