/* 积分流水页私有样式 */

.tx-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.tx-date {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.tx-delta {
  font-size: 26rpx;
  color: var(--color-text);
  margin-right: 16rpx;
}

.tx-after {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.tx-note {
  font-size: 24rpx;
  color: var(--color-text-muted);
}
