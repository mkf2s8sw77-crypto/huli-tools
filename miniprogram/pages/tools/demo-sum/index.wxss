/* demo-sum v3 — 应用执行页 */

.app-exec-header {
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-lg);
  border-radius: var(--radius-xl);
  background: var(--gradient-hero);
  box-shadow: var(--shadow-elevated);
  position: relative;
  overflow: hidden;
}
.app-exec-header::after {
  content: "";
  position: absolute;
  right: -42rpx;
  top: -54rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  background: var(--color-on-primary);
  opacity: 0.14;
  transition: transform var(--t-slow) var(--ease-out);
}
.app-exec-header.lift-on-hover:hover::after {
  transform: scale(1.1);
}

.app-exec-header__row {
  display: flex;
  align-items: center;
  gap: 26rpx;
  position: relative;
  z-index: 1;
}

.app-exec-header__info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.app-exec-header__name {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--color-on-primary);
  line-height: 1.25;
}

.app-exec-header__cost {
  align-self: flex-start;
  font-size: 25rpx;
  color: var(--color-accent-warm);
  background: rgba(255, 255, 255, 0.88);
  border-radius: var(--radius-pill);
  padding: 7rpx 18rpx;
  font-weight: 600;
  margin-top: 10rpx;
  font-variant-numeric: tabular-nums;
}

.app-exec-header .icon-tile {
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: none;
  --icon-line: var(--color-on-primary);
}

.app-exec-form-grid {
  margin-bottom: var(--spacing-sm);
}

.app-exec-toggle {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-surface);
  border-color: var(--color-border-soft);
}

.app-exec-btn {
  margin: var(--spacing-md) 0 var(--spacing-lg);
}

.app-exec-meta {
  background: var(--color-surface);
}
.app-exec-meta::before { display: none; }
.app-exec-meta__label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-bottom: 4rpx;
}
.app-exec-meta__value {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-family: var(--font-mono);
  word-break: break-all;
}
.app-exec-meta__cost {
  display: block;
  font-size: 24rpx;
  color: var(--color-accent-warm);
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.app-exec-result {
  text-align: center;
  padding: var(--spacing-xl) var(--spacing-lg);
  background: linear-gradient(135deg, var(--color-bg-card) 0%, var(--color-success-light) 100%);
}
.app-exec-result__label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: var(--spacing-sm);
  letter-spacing: 0.5rpx;
}
.app-exec-result__value {
  display: block;
  font-size: 64rpx;
  font-weight: 600;
  color: var(--color-success);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.app-exec-error {
  background: var(--color-danger-light);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-top: var(--spacing-md);
  text-align: center;
}
.app-exec-error text {
  font-size: 28rpx;
  color: var(--color-danger);
}
