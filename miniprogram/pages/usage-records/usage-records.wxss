/* 使用记录页私有样式 */

.record-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.record-app {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.record-cost {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.record-error {
  font-size: 24rpx;
  color: var(--color-danger);
}

.record-time {
  font-size: 22rpx;
  color: var(--color-text-muted);
}
