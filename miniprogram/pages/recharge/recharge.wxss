@import "../../app.wxss";

.header {
  margin-bottom: 48rpx;
  text-align: center;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.loading {
  display: block;
  font-size: 28rpx;
  color: #999;
  text-align: center;
}

.empty {
  display: block;
  font-size: 28rpx;
  color: #999;
  text-align: center;
}

.package-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.package-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.package-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.package-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff9900;
}

.package-body {
  margin-bottom: 24rpx;
}

.package-points,
.package-bonus,
.package-total {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.package-total {
  color: #07c160;
  font-weight: 500;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.subvalue {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.mock-card {
  border: 1rpx dashed #ff9900;
}

.link-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.link-text {
  font-size: 28rpx;
  color: #576b95;
}
