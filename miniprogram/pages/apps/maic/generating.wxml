<ui-page title="课程生成中" eyebrow="异步任务" subtitle="可以放心退出本页，后台协调任务会继续处理">
  <view class="card card--elevated maic-generation">
    <view class="maic-orbit {{status === 'processing' || status === 'importing' ? 'maic-orbit--active' : ''}}">
      <view class="maic-orbit__core"></view>
    </view>
    <text class="maic-generation__status">{{statusText}}</text>
    <text class="maic-generation__hint" wx:if="{{status === 'processing'}}">正在生成大纲、原生场景、互动与 PBL 路径</text>
    <view class="maic-progress">
      <view class="maic-progress__bar" style="width: {{progress}}%;"></view>
    </view>
    <text class="maic-generation__percent">{{progress}}%</text>
  </view>

  <view wx:if="{{errorMsg}}" class="maic-notice maic-notice--error">{{errorMsg}}</view>

  <view class="maic-generation__steps">
    <view class="maic-step {{progress >= 5 ? 'maic-step--done' : ''}}"><text>1</text><view><text class="maic-step__title">提交生成</text><text class="maic-step__desc">usageId 保证同一任务只生成一次</text></view></view>
    <view class="maic-step {{progress >= 40 ? 'maic-step--done' : ''}}"><text>2</text><view><text class="maic-step__title">课程编排</text><text class="maic-step__desc">生成四类原生场景和课堂动作</text></view></view>
    <view class="maic-step {{progress >= 80 ? 'maic-step--done' : ''}}"><text>3</text><view><text class="maic-step__title">导入云开发</text><text class="maic-step__desc">课程和场景按用户隔离保存</text></view></view>
  </view>

  <button wx:if="{{status !== 'succeeded' && status !== 'failed' && status !== 'cancelled' && status !== 'timed_out'}}" class="maic-secondary-btn" loading="{{cancelling}}" bindtap="cancelTask">取消生成</button>
  <button wx:else class="maic-secondary-btn" bindtap="backToCourses">返回课程列表</button>
</ui-page>
