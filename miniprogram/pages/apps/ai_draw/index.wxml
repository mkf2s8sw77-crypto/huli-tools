<ui-page title="{{appInfo ? appInfo.name : 'AI 绘图'}}" subtitle="输入描述，AI 为您生成图片">
  <ui-card wx:if="{{appInfo && appInfo.pricing}}">
    <text class="form-label">本次消耗</text>
    <text class="cost-points">{{appInfo.pricing.costPoints}} 积分</text>
  </ui-card>

  <ui-form-field label="绘图描述">
    <textarea
      class="prompt-input"
      value="{{prompt}}"
      bindinput="onInputPrompt"
      placeholder="请描述您想要的图片，例如：一只可爱的猫咪在草地上奔跑"
      maxlength="500"
      auto-height
    />
    <text class="char-count">{{prompt.length}}/500</text>
  </ui-form-field>

  <view class="btn-group">
    <button
      type="primary"
      loading="{{loading || polling}}"
      disabled="{{loading || polling || !prompt}}"
      bindtap="onGenerate"
    >
      {{loading ? '生成中...' : (polling ? '生成中(' + pollCount + ')...' : '生成图片')}}
    </button>
    <button
      wx:if="{{polling}}"
      class="cancel-btn"
      type="warn"
      size="mini"
      bindtap="onCancel"
    >
      取消
    </button>
  </view>

  <ui-card wx:if="{{imageUrl}}" extraClass="image-card">
    <text class="form-label">生成结果</text>
    <image class="result-image" mode="aspectFit" src="{{imageUrl}}" show-menu-by-longpress />
    <button class="save-btn" type="default" bindtap="onSaveImage">保存到相册</button>
  </ui-card>

  <view wx:if="{{errorMsg}}" class="error-card">
    <text>{{errorMsg}}</text>
  </view>
</ui-page>
