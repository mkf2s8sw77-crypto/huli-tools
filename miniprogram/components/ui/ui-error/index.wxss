@import "../../../styles/common.wxss";

.error-state__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-danger-light);
  color: var(--color-danger);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: var(--spacing-sm);
}

.error-state__btn {
  margin-top: var(--spacing-sm);
}
