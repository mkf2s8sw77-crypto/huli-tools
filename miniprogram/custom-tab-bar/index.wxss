@import "../styles/tokens.wxss";

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  padding: 16rpx 48rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, transparent 0%, var(--color-surface) 30%);
  z-index: 1000;
}

.tab-bar__inner {
  display: flex;
  gap: 8rpx;
  background: var(--color-surface-elevated);
  border-radius: var(--radius-pill);
  padding: 8rpx;
  box-shadow: var(--shadow-elevated);
  border: 1rpx solid var(--color-border-soft);
}

.tab-bar-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 168rpx;
  padding: 16rpx 48rpx;
  min-height: 96rpx;
  box-sizing: border-box;
  border-radius: var(--radius-pill);
  transition: all 0.2s ease;
}

.tab-bar-item.active {
  background: var(--gradient-primary);
}

.tab-bar-item__icon {
  font-size: 32rpx;
  color: var(--color-text-muted);
  line-height: 1;
}

.tab-bar-item.active .tab-bar-item__icon {
  color: var(--color-on-primary);
}

.tab-text {
  font-size: 28rpx;
  color: var(--color-text-muted);
  font-weight: 500;
  line-height: 1;
}

.tab-bar-item.active .tab-text {
  color: var(--color-on-primary);
  font-weight: 600;
}
