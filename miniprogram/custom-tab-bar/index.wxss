@import "../styles/tokens.wxss";

/* v4.1 悬浮白胶囊 tabbar */
.tab-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 36rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  height: 136rpx;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 44rpx;
  border: 1rpx solid var(--color-border);
  box-shadow: 0 20rpx 60rpx rgba(60, 40, 110, 0.14);
  display: flex;
  z-index: 1000;
}

.tab-bar-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  gap: 8rpx;
  min-width: 0;
  color: var(--color-text-muted);
  transition: color var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-out);
}

.tab-bar-item:active {
  transform: scale(0.96);
}

.tab-bar-item.active {
  color: var(--color-primary-hover);
}

.tab-text {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  color: inherit;
}

.tab-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  color: inherit;
}

.tab-icon::before,
.tab-icon::after,
.tab-icon__glyph::before,
.tab-icon__glyph::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

/* 工具:四宫格线框 */
.tab-icon--grid::before {
  left: 2rpx;
  top: 2rpx;
  width: 12rpx;
  height: 12rpx;
  border: 4rpx solid currentColor;
  border-radius: 5rpx;
}

.tab-icon--grid::after {
  left: 24rpx;
  top: 2rpx;
  width: 12rpx;
  height: 12rpx;
  border: 4rpx solid currentColor;
  border-radius: 5rpx;
}

.tab-icon--grid .tab-icon__glyph::before {
  left: 2rpx;
  top: 24rpx;
  width: 12rpx;
  height: 12rpx;
  border: 4rpx solid currentColor;
  border-radius: 5rpx;
}

.tab-icon--grid .tab-icon__glyph::after {
  left: 24rpx;
  top: 24rpx;
  width: 12rpx;
  height: 12rpx;
  border: 4rpx solid currentColor;
  border-radius: 5rpx;
}

/* 我的:小人像线框 */
.tab-icon--profile::before {
  left: 12rpx;
  top: 3rpx;
  width: 12rpx;
  height: 12rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.tab-icon--profile::after {
  left: 5rpx;
  bottom: 3rpx;
  width: 26rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-bottom: none;
  border-radius: 18rpx 18rpx 0 0;
}
