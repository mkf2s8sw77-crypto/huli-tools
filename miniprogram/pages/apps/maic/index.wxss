@import "./common.wxss";

.maic-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.maic-brand__identity {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.maic-brand__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  color: var(--color-on-primary);
  background: var(--gradient-tile-maic);
  box-shadow: var(--shadow-tile-maic);
}

.maic-brand__mark text {
  font-family: var(--font-sans);
  font-size: 38rpx;
  font-weight: 700;
}

.maic-brand__name,
.maic-brand__caption {
  display: block;
}

.maic-brand__name {
  color: var(--color-maic-ink);
  font-family: var(--font-sans);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.maic-brand__caption {
  margin-top: 2rpx;
  color: var(--color-maic-muted);
  font-size: 21rpx;
  letter-spacing: 4rpx;
}

.maic-free-badge {
  padding: 9rpx 18rpx;
  border: 1rpx solid var(--color-maic-border);
  border-radius: var(--radius-pill);
  color: var(--color-maic-cyan);
  background: var(--color-maic-surface);
  font-size: 21rpx;
  font-weight: 600;
}

.maic-workbench {
  position: relative;
  margin: 0 -8rpx 30rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-maic-border);
  border-radius: 34rpx;
  color: var(--color-text);
  background: var(--color-maic-surface);
  box-shadow: var(--shadow-card);
}

.maic-workbench__content {
  position: relative;
  z-index: 1;
  padding: 42rpx 30rpx 30rpx;
}

.maic-workbench__glow {
  position: absolute;
  border-radius: 50%;
  background: var(--color-maic-cyan);
  opacity: 0.10;
}

.maic-workbench__glow--one {
  top: -110rpx;
  right: -80rpx;
  width: 330rpx;
  height: 330rpx;
}

.maic-workbench__glow--two {
  bottom: -160rpx;
  left: -100rpx;
  width: 300rpx;
  height: 300rpx;
  background: var(--color-maic-cyan);
}

.maic-workbench__eyebrow,
.maic-workbench__title,
.maic-workbench__desc {
  display: block;
}

.maic-workbench__eyebrow {
  color: var(--color-maic-cyan);
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.maic-workbench__title {
  margin-top: 12rpx;
  font-family: var(--font-sans);
  font-size: 43rpx;
  font-weight: 600;
  line-height: 1.35;
}

.maic-workbench__desc {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.65;
}

.maic-composer {
  margin-top: 28rpx;
  padding: 10rpx;
  border: 1rpx solid var(--color-maic-border);
  border-radius: 24rpx;
  color: var(--color-maic-ink);
  background: var(--color-maic-bg);
}

.maic-composer__topic,
.maic-composer__requirements {
  box-sizing: border-box;
  width: 100%;
  color: var(--color-maic-ink);
  background: transparent;
}

.maic-composer__topic {
  min-height: 190rpx;
  padding: 26rpx 24rpx 18rpx;
  font-size: 29rpx;
  line-height: 1.65;
}

.maic-composer__requirements {
  min-height: 88rpx;
  margin-top: 10rpx;
  padding: 18rpx 20rpx;
  border-top: 1rpx solid var(--color-maic-border);
  color: var(--color-maic-muted);
  font-size: 23rpx;
  line-height: 1.55;
}

.maic-toolbar {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  padding: 0 10rpx;
}

.maic-toolbar__picker {
  flex: 0 0 190rpx;
  align-self: stretch;
}

.maic-toolbar__picker .maic-toolbar__field {
  height: 100%;
}

.maic-toolbar__field {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 92rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--color-maic-border);
  border-radius: 16rpx;
  background: var(--color-maic-surface);
}

.maic-toolbar__field--grow {
  flex: 1;
  min-width: 0;
}

.maic-toolbar__label,
.maic-toolbar__value {
  display: block;
}

.maic-toolbar__label {
  color: var(--color-maic-muted);
  font-size: 19rpx;
}

.maic-toolbar__input,
.maic-toolbar__value {
  margin-top: 6rpx;
  color: var(--color-maic-ink-soft);
  font-size: 23rpx;
  font-weight: 500;
  line-height: 34rpx;
}

.maic-toolbar__input {
  height: 34rpx;
}

.maic-composer__footer {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 10rpx;
}

.maic-composer__meta {
  color: var(--color-maic-muted);
  font-size: 20rpx;
  text-align: center;
}

.maic-submit.ui-action-btn {
  min-height: 78rpx;
  border-radius: 16rpx !important;
  background: var(--gradient-tile-maic) !important;
  font-size: 28rpx;
  box-shadow: var(--shadow-tile-maic) !important;
}

.maic-recent {
  margin-top: 36rpx;
}

.maic-recent__heading {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 30rpx;
  color: var(--color-maic-muted);
  font-size: 23rpx;
}

.maic-recent__line {
  flex: 1;
  height: 1rpx;
  background: var(--color-maic-border);
}

.maic-recent__count {
  color: var(--color-maic-cyan);
  font-weight: 600;
}

.maic-course-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx 20rpx;
}

.maic-course-card {
  min-width: 0;
}

.maic-course-card__cover {
  position: relative;
  height: 190rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-maic-border);
  border-radius: 20rpx;
  color: var(--color-maic-muted);
  background: var(--color-maic-bg);
}

.maic-course-card__index {
  position: absolute;
  top: 18rpx;
  left: 20rpx;
  z-index: 1;
  font-family: var(--font-mono);
  font-size: 22rpx;
  opacity: 0.8;
}

.maic-course-card__scenes {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 1;
  font-family: var(--font-mono);
  font-size: 17rpx;
  letter-spacing: 1rpx;
  opacity: 0.8;
}

.maic-course-card__orbit {
  position: absolute;
  top: 38rpx;
  right: 42rpx;
  width: 118rpx;
  height: 118rpx;
  border: 1rpx solid var(--color-maic-cyan);
  border-radius: 50%;
  opacity: 0.38;
}

.maic-course-card__orbit::before,
.maic-course-card__orbit::after {
  content: "";
  position: absolute;
  border-radius: 50%;
}

.maic-course-card__orbit::before {
  inset: 24rpx;
  background: var(--color-maic-cyan);
  opacity: 0.7;
}

.maic-course-card__orbit::after {
  top: -6rpx;
  left: 48rpx;
  width: 13rpx;
  height: 13rpx;
  background: var(--color-maic-cyan);
}

.maic-course-card__title {
  margin-top: 18rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.45;
}

.maic-course-card__summary {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.55;
  -webkit-line-clamp: 2;
}

.maic-course-card__date {
  display: block;
  margin-top: 10rpx;
  color: var(--color-maic-muted);
  font-size: 19rpx;
}
