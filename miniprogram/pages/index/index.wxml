<ui-page variant="dashboard">
  <view wx:if="{{loading}}">
    <!-- 骨架首屏:与最终布局同形,避免白屏 -->
    <view class="topbar">
      <view class="brand">
        <view class="skeleton" style="width: 64rpx; height: 64rpx; border-radius: 20rpx;"></view>
        <view class="skeleton" style="width: 180rpx; height: 34rpx; border-radius: 10rpx;"></view>
      </view>
      <view class="skeleton" style="width: 120rpx; height: 62rpx; border-radius: 999rpx;"></view>
    </view>
    <view class="slogan">
      <view class="skeleton" style="width: 68%; height: 52rpx; border-radius: 14rpx;"></view>
      <view class="skeleton" style="width: 42%; height: 28rpx; border-radius: 10rpx; margin-top: 14rpx;"></view>
    </view>
    <view class="bento">
      <view class="skeleton tile-skeleton tile-skeleton--tall"></view>
      <view class="skeleton tile-skeleton"></view>
      <view class="skeleton tile-skeleton"></view>
      <view class="skeleton tile-skeleton"></view>
      <view class="skeleton tile-skeleton tile-skeleton--more"></view>
    </view>
  </view>

  <view wx:elif="{{error}}">
    <ui-error text="{{error}}" bind:retry="loadHomeData" />
  </view>

  <block wx:else>
    <!-- 顶栏:品牌 + 积分胶囊 -->
    <view class="topbar fade-in">
      <view class="brand">
        <image class="brand__logo" src="/assets/images/huli-tech-logo.png" mode="aspectFill" />
        <text class="brand__name">huli 工具箱</text>
      </view>
      <view class="points-pill" bindtap="onGoRecharge">
        <view class="points-pill__bolt"></view>
        <text class="points-pill__num">{{userSummary.points.availablePoints}}</text>
      </view>
    </view>

    <!-- slogan -->
    <view class="slogan fade-in fade-in-1">
      <text class="slogan__main">护理人的 AI 工具箱</text>
      <text class="slogan__sub">挑个工具，直接开工</text>
    </view>

    <!-- bento 工具墙(空目录时显示空状态) -->
    <ui-empty wx:if="{{apps.length === 0}}" text="暂无可用应用" />

    <view wx:else class="bento fade-in fade-in-2">
      <view
        wx:for="{{apps}}"
        wx:key="appKey"
        class="tile {{item.tileClass}} {{index === 0 ? 'tile--tall' : ''}}"
        data-app="{{item}}"
        bindtap="onTapApp"
      >
        <view class="tile__glyph"></view>
        <view wx:if="{{item.tag}}" class="tile__tag {{item.tagHot ? 'tile__tag--hot' : ''}}">{{item.tag}}</view>
        <view class="tile__spacer"></view>
        <text class="tile__name">{{item.name}}</text>
        <text class="tile__desc">{{item.description || ''}}</text>
        <view class="tile__price {{item.priceFree ? 'tile__price--free' : ''}}">{{item.priceText}}</view>
      </view>

      <!-- 更多工具占位砖 -->
      <view class="tile tile--more">
        <view class="tile-more__plus">+</view>
        <view class="tile-more__texts">
          <text class="tile-more__name">更多护理工具</text>
          <text class="tile-more__desc">持续上新，敬请期待</text>
        </view>
      </view>
    </view>
  </block>
</ui-page>
