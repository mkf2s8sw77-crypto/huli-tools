<ui-page title="{{appInfo ? appInfo.name : '积分示例工具'}}" subtitle="演示积分扣费链路">
  <!-- 应用头部 + 费用提示 -->
  <view class="app-exec-header card card--soft" wx:if="{{appInfo && appInfo.pricing && appInfo.pricing.mode === 'fixed'}}">
    <view class="app-exec-header__row">
      <view class="app-icon-symbol app-icon-symbol--lavender">
        <text>∑</text>
      </view>
      <view class="app-exec-header__info">
        <text class="app-exec-header__name">{{appInfo.name || '积分示例'}}</text>
        <text class="app-exec-header__cost">本次消耗 {{appInfo.pricing.costPoints}} 积分</text>
      </view>
    </view>
  </view>

  <!-- 表单卡 -->
  <ui-form-field label="数字 A">
    <input type="number" value="{{a}}" bindinput="onInputA" placeholder="请输入数字" class="form-input" />
  </ui-form-field>

  <ui-form-field label="数字 B">
    <input type="number" value="{{b}}" bindinput="onInputB" placeholder="请输入数字" class="form-input" />
  </ui-form-field>

  <view class="card" style="display:flex;align-items:center;gap:var(--spacing-sm);">
    <switch checked="{{triggerFail}}" bindchange="onToggleFail" />
    <text class="form-label" style="margin-bottom:0;">模拟业务失败（测试释放积分）</text>
  </view>

  <!-- 主操作区 -->
  <ui-action-button
    text="计算求和"
    loading="{{loading}}"
    disabled="{{loading}}"
    bind:tap="onCalc"
    extra-class="app-exec-btn"
  />

  <!-- 使用记录 -->
  <view wx:if="{{usageId}}" class="card app-exec-meta">
    <text class="app-exec-meta__label">使用记录 ID</text>
    <text class="app-exec-meta__value">{{usageId}}</text>
    <text wx:if="{{costPoints > 0}}" class="app-exec-meta__cost">消耗 {{costPoints}} 积分</text>
  </view>

  <!-- 结果区 -->
  <view wx:if="{{result !== null}}" class="card card--elevated app-exec-result">
    <text class="app-exec-result__label">计算结果</text>
    <text class="app-exec-result__value">{{result}}</text>
  </view>

  <!-- 错误 -->
  <view wx:if="{{error}}" class="app-exec-error">
    <text>{{error}}</text>
  </view>
</ui-page>
