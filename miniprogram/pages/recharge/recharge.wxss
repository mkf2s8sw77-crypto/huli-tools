/* 充值页私有样式 */

.package-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.package-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.package-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.package-price {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-price);
}

.package-body {
  margin-bottom: 24rpx;
}

.package-points,
.package-bonus,
.package-total {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.package-total {
  color: var(--color-points);
  font-weight: 500;
}

.subvalue {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: 16rpx;
}

.mock-card {
  border: 1rpx dashed var(--color-warning);
}

.link-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.link-text {
  font-size: 28rpx;
  color: var(--color-primary);
}
