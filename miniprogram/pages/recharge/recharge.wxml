<ui-page>
  <!-- 标题区 -->
  <view class="recharge-head fade-in">
    <text class="recharge-head__title">为账户补充积分</text>
    <text class="recharge-head__sub">选择下方任一充值包，实时到账</text>
  </view>

  <view wx:if="{{loading}}">
    <ui-card>
      <view class="skeleton" style="height: 96rpx; margin-bottom: 12rpx; border-radius: 16rpx;"></view>
      <view class="skeleton" style="height: 96rpx; margin-bottom: 12rpx; border-radius: 16rpx;"></view>
      <view class="skeleton" style="height: 96rpx; border-radius: 16rpx;"></view>
    </ui-card>
  </view>

  <view wx:elif="{{packages.length === 0}}">
    <ui-empty text="暂无充值包" />
  </view>

  <view wx:else>
    <ui-section title="充值套餐">
      <view
        wx:for="{{packages}}"
        wx:key="packageKey"
        class="pkg-card card lift-on-hover fade-in-{{index % 4 + 1}}"
      >
        <view wx:if="{{item.bonusPoints > 0}}" class="pkg-card__hot">推荐</view>
        <view class="pkg-card__head">
          <text class="pkg-card__name">{{item.name}}</text>
          <text class="pkg-card__price"><text class="pkg-card__price-cur">¥</text>{{item.amountYuan}}</text>
        </view>
        <view class="pkg-card__lines">
          <view class="pkg-card__line">
            <text class="pkg-card__label">基础积分</text>
            <text class="pkg-card__val">{{item.basePoints}}</text>
          </view>
          <view wx:if="{{item.bonusPoints > 0}}" class="pkg-card__line">
            <text class="pkg-card__label">赠送积分</text>
            <text class="pkg-card__val pkg-card__val--bonus">+{{item.bonusPoints}}</text>
          </view>
          <view class="pkg-card__line pkg-card__line--total">
            <text class="pkg-card__label">到账总计</text>
            <ui-price value="{{item.basePoints + item.bonusPoints}}" type="points" size="md" suffix=" 积分" />
          </view>
        </view>
        <button
          type="primary"
          size="mini"
          loading="{{creating}}"
          disabled="{{creating}}"
          data-pkg="{{item}}"
          bindtap="onTapPackage"
          class="pkg-card__btn"
        >{{provider === 'virtual' ? '立即充值' : '创建订单'}}</button>
      </view>
    </ui-section>
  </view>

  <view wx:if="{{payingOrderNo && mockEnabled && provider !== 'virtual'}}" class="card mock-card fade-in">
    <text class="form-label">模拟支付(开发/测试)</text>
    <text class="mock-card__order">订单号: {{payingOrderNo}}</text>
    <button
      type="warn"
      size="mini"
      loading="{{paying}}"
      disabled="{{paying}}"
      bindtap="onMockPay"
    >模拟支付到账</button>
  </view>

  <view wx:if="{{payingOrderNo && provider === 'virtual'}}" class="card mock-card fade-in">
    <text class="form-label">支付结果确认中…</text>
    <text class="mock-card__order">订单号: {{payingOrderNo}}</text>
  </view>

  <view class="card link-card lift-on-hover" bindtap="onGoOrders">
    <text class="link-card__text">查看我的订单</text>
    <text class="menu-item__arrow">›</text>
  </view>
</ui-page>
