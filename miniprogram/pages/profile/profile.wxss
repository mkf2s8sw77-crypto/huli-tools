/* 我的页面 v3 — 自然疗愈服务面板 */

.service-card {
  position: relative;
  border-radius: var(--radius-xl);
  overflow: hidden;
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-elevated);
  background: var(--gradient-hero);
}
.service-card::after {
  content: "";
  position: absolute;
  top: -60rpx;
  right: -30rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: var(--color-on-primary);
  opacity: 0.10;
}

.service-card__content {
  position: relative;
  z-index: 1;
  padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-lg);
  color: var(--color-on-primary);
}

.service-card__eyebrow {
  font-size: 24rpx;
  color: var(--color-on-primary);
  opacity: 0.85;
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: 0.5rpx;
}

.service-card__title {
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.05;
  display: block;
  margin-top: 8rpx;
}
.service-card__desc {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: var(--color-on-primary);
  opacity: 0.82;
}

/* ── 身份栏(独立卡) ── */
.id-bar {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-card);
}

.id-bar__text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-family: var(--font-mono);
}

.brand-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  box-shadow: var(--shadow-soft);
}
