@import "../../app.wxss";

.header {
  margin-bottom: 48rpx;
  text-align: center;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.loading {
  display: block;
  font-size: 28rpx;
  color: #999;
  text-align: center;
}

.empty {
  display: block;
  font-size: 28rpx;
  color: #999;
  text-align: center;
  margin-bottom: 16rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.value {
  display: block;
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  font-family: monospace;
}

.points-card {
  text-align: center;
}

.points-card .label {
  text-align: center;
}

.points {
  display: block;
  font-size: 64rpx;
  font-weight: 600;
  color: #07c160;
  margin-bottom: 16rpx;
}

.points-sub {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.frozen {
  display: block;
  font-size: 26rpx;
  color: #ff9900;
}

.sub {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.menu {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 28rpx;
  color: #999;
}
