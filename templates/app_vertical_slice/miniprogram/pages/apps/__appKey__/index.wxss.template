/* __appKey__ 页面私有样式 — 平台通用样式由 app.wxss 提供 */
/* 新应用不得重新定义平台主色、卡片、按钮、状态标签等公共视觉规则 */

.result-section {
  margin-top: 24rpx;
}

.result-value {
  font-size: 32rpx;
  color: var(--color-success);
  font-weight: 600;
}

.error-section {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--color-danger-light);
  border-radius: 16rpx;
}

.error-text {
  font-size: 28rpx;
  color: var(--color-danger);
}
