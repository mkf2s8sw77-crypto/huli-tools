@import "../../app.wxss";

.header {
  margin-bottom: 48rpx;
  text-align: center;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.loading {
  display: block;
  font-size: 28rpx;
  color: #999;
  text-align: center;
}

.empty {
  display: block;
  font-size: 28rpx;
  color: #999;
  text-align: center;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-row:last-child {
  margin-bottom: 0;
}

.order-no {
  font-size: 24rpx;
  color: #999;
  font-family: monospace;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #666;
}

.order-status.paid {
  background: #e6f7ed;
  color: #07c160;
}

.order-status.created,
.order-status.pending_pay {
  background: #fff7e6;
  color: #ff9900;
}

.order-status.closed,
.order-status.failed,
.order-status.refunded {
  background: #f5f5f5;
  color: #999;
}

.order-package {
  font-size: 28rpx;
  color: #333;
}

.order-amount {
  font-size: 28rpx;
  color: #ff9900;
  font-weight: 500;
}

.order-points {
  font-size: 26rpx;
  color: #07c160;
}

.order-time,
.order-paid {
  font-size: 22rpx;
  color: #999;
}

.load-more {
  text-align: center;
  padding: 24rpx;
}

.load-more-text {
  font-size: 26rpx;
  color: #999;
}
