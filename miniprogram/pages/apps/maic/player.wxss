@import "./common.wxss";

page {
  height: 100%;
  overflow: hidden;
  background: var(--color-maic-bg);
}

.maic-player {
  height: 100vh;
  padding: 18rpx 22rpx calc(176rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: var(--color-maic-ink);
  background: var(--color-maic-bg);
}

.maic-player__loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 70vh;
  gap: 28rpx;
  color: var(--color-maic-muted);
  font-size: 28rpx;
}

.maic-player__loading-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border: 2rpx solid var(--color-maic-border);
  border-radius: 50%;
  animation: maic-orbit-spin 1.8s linear infinite;
}

.maic-player__loading-mark view {
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx 22rpx 12rpx 22rpx;
  background: var(--color-maic-cyan);
}

@keyframes maic-orbit-spin { to { transform: rotate(360deg); } }

.maic-player__topbar {
  height: 74rpx;
  padding: 0 6rpx;
}

.maic-player__chapter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--color-maic-muted);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.maic-player__chapter text:first-child { color: var(--color-maic-blue); }

.maic-player__progress {
  height: 5rpx;
  margin-top: 15rpx;
  overflow: hidden;
  background: var(--color-maic-border);
}

.maic-player__progress view {
  height: 100%;
  background: var(--color-maic-cyan);
  transition: width var(--t-slow) var(--ease-out);
}

.maic-stage {
  position: relative;
  display: flex;
  flex-direction: column;
  height: calc(100vh - 268rpx - env(safe-area-inset-bottom));
  min-height: 720rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-maic-border);
  border-radius: 30rpx 30rpx 10rpx 30rpx;
  background: var(--color-maic-surface);
  box-shadow: var(--shadow-maic);
}

.maic-stage__grid {
  position: absolute;
  z-index: 0;
  inset: 0;
  opacity: .28;
  background-image: linear-gradient(var(--color-maic-border) 1rpx, transparent 1rpx), linear-gradient(90deg, var(--color-maic-border) 1rpx, transparent 1rpx);
  background-size: 48rpx 48rpx;
  pointer-events: none;
}

.maic-stage__orb {
  position: absolute;
  z-index: 1;
  border-radius: 50%;
  opacity: .15;
  pointer-events: none;
}

.maic-stage__orb--one { top: -120rpx; right: -80rpx; width: 280rpx; height: 280rpx; background: var(--color-maic-cyan); }
.maic-stage__orb--two { top: 160rpx; right: 36rpx; width: 76rpx; height: 76rpx; border: 18rpx solid var(--color-maic-blue); }

.maic-stage__viewport {
  position: relative;
  z-index: 2;
  flex: 1;
  min-height: 0;
  width: 100%;
}

.maic-stage__header {
  position: relative;
  min-height: 230rpx;
  padding: 34rpx 34rpx 52rpx;
  box-sizing: border-box;
  color: var(--color-on-primary);
  background: linear-gradient(145deg, var(--color-maic-ink), var(--color-maic-ink-soft));
}

.maic-stage--hero .maic-stage__header { min-height: 320rpx; padding-top: 48rpx; }
.maic-stage--challenge .maic-stage__header { min-height: 210rpx; }
.maic-stage--caseboard .maic-stage__header { border-bottom: 10rpx solid var(--color-maic-cyan); }
.maic-stage--process .maic-stage__header { border-right: 22rpx solid var(--color-maic-cyan); }
.maic-stage--compare .maic-stage__header { border-left: 22rpx solid var(--color-maic-blue); }

.maic-stage__eyebrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: var(--color-maic-soft);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.maic-stage__eyebrow text:last-child { opacity: .55; font-size: 17rpx; }

.maic-stage__title {
  display: block;
  width: 88%;
  margin-top: 28rpx;
  font-family: var(--font-serif);
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 1rpx;
}

.maic-stage--hero .maic-stage__title { margin-top: 40rpx; font-size: 58rpx; }

.maic-stage__guide {
  display: block;
  width: 76%;
  margin-top: 20rpx;
  color: var(--color-maic-soft);
  font-size: 24rpx;
  line-height: 1.6;
}

.maic-stage__body {
  position: relative;
  min-height: 520rpx;
  padding: 34rpx 30rpx 20rpx;
  box-sizing: border-box;
  background: var(--color-maic-surface);
}

.maic-stage--hero .maic-stage__body {
  margin-top: -30rpx;
  border-radius: 30rpx 30rpx 0 0;
}

.maic-stage__body-spacer { height: 24rpx; }

.maic-block {
  position: relative;
  margin-bottom: 28rpx;
  padding: 26rpx 24rpx 24rpx 34rpx;
  border-left: 5rpx solid var(--color-maic-border);
  border-radius: 0 18rpx 18rpx 0;
  background: var(--color-maic-bg);
  transition: all var(--t-base) var(--ease-out);
}

.maic-block--lead { border-left-color: var(--color-maic-blue); background: var(--color-maic-soft); }
.maic-block--highlight { border-left-color: var(--color-accent-warm); transform: translateX(8rpx); box-shadow: var(--shadow-maic-blue); }
.maic-block--spotlight { z-index: 3; border-left-color: var(--color-maic-cyan); box-shadow: 0 0 0 3000rpx var(--color-maic-spotlight-mask); }

.maic-block__index {
  position: absolute;
  top: -13rpx;
  left: -17rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  color: var(--color-on-primary);
  background: var(--color-maic-ink);
  font-family: var(--font-mono);
  font-size: 18rpx;
}

.maic-paragraph,
.maic-question,
.maic-case {
  display: block;
  color: var(--color-maic-ink-soft);
  font-size: 29rpx;
  line-height: 1.82;
}

.maic-block--lead .maic-paragraph { font-family: var(--font-serif); font-size: 32rpx; line-height: 1.72; }

.maic-list view {
  display: grid;
  grid-template-columns: 44rpx 1fr;
  gap: 12rpx;
  margin-bottom: 17rpx;
  color: var(--color-maic-ink-soft);
  font-size: 28rpx;
  line-height: 1.65;
}

.maic-list view:last-child { margin-bottom: 0; }
.maic-list view text:first-child { color: var(--color-maic-blue); font-family: var(--font-mono); font-weight: 700; }

.maic-callout {
  position: relative;
  padding: 28rpx;
  overflow: hidden;
  border-radius: 4rpx 24rpx 24rpx 24rpx;
  color: var(--color-maic-ink-soft);
  background: var(--color-maic-soft);
  font-size: 27rpx;
  line-height: 1.75;
}

.maic-callout::before { content: ''; position: absolute; top: 0; left: 0; width: 80rpx; height: 8rpx; background: var(--color-maic-cyan); }
.maic-callout--success { background: var(--color-success-light); }
.maic-callout--warning { background: var(--color-warning-light); }
.maic-callout--warning::before { background: var(--color-accent-warm); }
.maic-callout__title { display: block; margin-bottom: 10rpx; color: var(--color-maic-ink); font-family: var(--font-serif); font-size: 29rpx; font-weight: 700; }

.maic-image { width: 100%; border-radius: 4rpx 22rpx 22rpx 22rpx; }
.maic-image__caption { display: block; margin-top: 12rpx; color: var(--color-maic-muted); font-size: 23rpx; }

.maic-table-wrap { width: 100%; border-radius: 4rpx 20rpx 20rpx 20rpx; }
.maic-table { min-width: 640rpx; overflow: hidden; border: 1rpx solid var(--color-maic-border); }
.maic-table__row { display: flex; }
.maic-table__row text { flex: 1; min-width: 170rpx; padding: 19rpx 16rpx; border-right: 1rpx solid var(--color-maic-border); border-bottom: 1rpx solid var(--color-maic-border); color: var(--color-maic-ink-soft); font-size: 24rpx; line-height: 1.5; }
.maic-table__head { color: var(--color-on-primary); background: var(--color-maic-ink); font-weight: 600; }
.maic-table__head text { color: var(--color-on-primary); }

.maic-step-list { position: relative; }
.maic-step-list::before { content: ''; position: absolute; top: 20rpx; bottom: 30rpx; left: 24rpx; width: 3rpx; background: var(--color-maic-border); }
.maic-step-list > view,
.maic-reveal-step { position: relative; display: grid; grid-template-columns: 54rpx 1fr; gap: 20rpx; margin-bottom: 28rpx; }
.maic-step-list text,
.maic-reveal-step text { display: block; color: var(--color-maic-ink-soft); font-size: 26rpx; line-height: 1.62; }
.maic-step-list__num,
.maic-reveal-step > text { z-index: 1; display: flex !important; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; border-radius: 50%; color: var(--color-on-primary) !important; background: var(--color-maic-blue); font-family: var(--font-mono); }
.maic-step-list__title,
.maic-reveal-step__title { margin-bottom: 6rpx; color: var(--color-maic-ink) !important; font-family: var(--font-serif); font-size: 28rpx !important; font-weight: 700; }

.maic-diagram { display: flex; flex-wrap: wrap; gap: 16rpx; }
.maic-diagram__node { padding: 20rpx 24rpx; border: 2rpx solid var(--color-maic-blue); border-radius: 4rpx 18rpx 18rpx 18rpx; color: var(--color-maic-blue); background: var(--color-maic-soft); font-size: 26rpx; font-weight: 600; }
.maic-diagram__edge { width: 100%; padding-left: 12rpx; color: var(--color-maic-muted); font-family: var(--font-mono); font-size: 22rpx; }

.maic-challenge-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
  color: var(--color-maic-cyan);
  font-family: var(--font-mono);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.maic-challenge-heading text:last-child { color: var(--color-maic-border); font-size: 50rpx; line-height: 1; }
.maic-question { margin-bottom: 32rpx; color: var(--color-maic-ink); font-family: var(--font-serif); font-size: 34rpx; font-weight: 700; line-height: 1.55; }

.maic-option {
  display: grid;
  grid-template-columns: 50rpx 1fr;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--color-maic-border);
  border-radius: 4rpx 18rpx 18rpx 18rpx;
  color: var(--color-maic-ink-soft);
  background: var(--color-maic-surface);
  font-size: 27rpx;
  line-height: 1.55;
}

.maic-option__index { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; color: var(--color-maic-blue); background: var(--color-maic-soft); font-family: var(--font-mono); font-size: 20rpx; }
.maic-option--selected { border-color: var(--color-maic-blue); color: var(--color-maic-blue); background: var(--color-maic-soft); transform: translateX(6rpx); }
.maic-option--selected .maic-option__index { color: var(--color-on-primary); background: var(--color-maic-blue); }
.maic-option--correct { border-color: var(--color-success); background: var(--color-success-light); }

.maic-primary-btn { margin-top: 28rpx; border-radius: 4rpx 20rpx 20rpx 20rpx; color: var(--color-on-primary); background: var(--color-maic-blue); box-shadow: var(--shadow-maic-blue); }
.maic-primary-btn::after { border: none; }

.maic-feedback { margin-top: 26rpx; padding: 28rpx; border-left: 8rpx solid; border-radius: 0 20rpx 20rpx 0; font-size: 26rpx; line-height: 1.72; }
.maic-feedback--correct { border-left-color: var(--color-success); color: var(--color-success); background: var(--color-success-light); }
.maic-feedback--wrong { border-left-color: var(--color-danger); color: var(--color-danger); background: var(--color-danger-light); }
.maic-feedback__title { display: block; margin-bottom: 9rpx; font-family: var(--font-serif); font-size: 29rpx; font-weight: 700; }

.maic-tabs { width: 100%; margin-bottom: 22rpx; }
.maic-tabs__inner { display: flex; gap: 12rpx; white-space: nowrap; }
.maic-tab { padding: 15rpx 24rpx; border: 1rpx solid var(--color-maic-border); border-radius: 2rpx 16rpx 16rpx 16rpx; color: var(--color-maic-muted); background: var(--color-maic-surface); font-size: 25rpx; }
.maic-tab--active { border-color: var(--color-maic-blue); color: var(--color-on-primary); background: var(--color-maic-blue); }
.maic-tab-content { display: block; padding: 26rpx; border-left: 6rpx solid var(--color-maic-cyan); color: var(--color-maic-ink-soft); background: var(--color-maic-soft); font-size: 27rpx; line-height: 1.75; }
.maic-interaction-hint,
.maic-result-text { display: block; margin: 18rpx 0; color: var(--color-maic-muted); font-size: 24rpx; }

.maic-match-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.maic-match-item { display: block; margin-bottom: 14rpx; padding: 18rpx; border: 1rpx solid var(--color-maic-border); border-radius: 4rpx 16rpx 16rpx 16rpx; color: var(--color-maic-ink-soft); background: var(--color-maic-bg); font-size: 24rpx; line-height: 1.55; }
.maic-match-item--active { border-color: var(--color-maic-blue); color: var(--color-maic-blue); background: var(--color-maic-soft); }
.maic-match-item--used { opacity: .42; }
.maic-match-result { margin-top: 12rpx; padding: 15rpx 18rpx; border-left: 5rpx solid var(--color-danger); color: var(--color-danger); background: var(--color-danger-light); font-size: 23rpx; }
.maic-match-result--correct { border-left-color: var(--color-success); color: var(--color-success); background: var(--color-success-light); }

.maic-sort-item { display: grid; grid-template-columns: 42rpx 1fr auto; align-items: center; gap: 12rpx; margin-bottom: 14rpx; padding: 18rpx; border-left: 5rpx solid var(--color-maic-border); background: var(--color-maic-bg); }
.maic-sort-item > text { font-size: 25rpx; line-height: 1.5; }
.maic-sort-item__number { color: var(--color-maic-blue); font-family: var(--font-mono); font-weight: 700; }
.maic-sort-item button { display: inline-block; margin-left: 5rpx; padding: 0 12rpx; color: var(--color-maic-blue); background: var(--color-maic-soft); font-size: 20rpx; }

.maic-hotspot { position: relative; height: 480rpx; margin-bottom: 18rpx; overflow: hidden; border: 1rpx solid var(--color-maic-border); border-radius: 4rpx 22rpx 22rpx 22rpx; background: var(--color-maic-bg); }
.maic-hotspot image { width: 100%; height: 100%; }
.maic-hotspot__point { position: absolute; display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; transform: translate(-50%, -50%); border: 5rpx solid var(--color-on-primary); border-radius: 50%; color: var(--color-on-primary); background: var(--color-accent-warm); box-shadow: var(--shadow-elevated); }
.maic-hotspot__point--active { background: var(--color-success); }

.maic-case-file { position: relative; margin-bottom: 28rpx; padding: 32rpx 28rpx; border-top: 8rpx solid var(--color-maic-cyan); color: var(--color-maic-ink-soft); background: var(--color-maic-soft); box-shadow: var(--shadow-maic-soft); }
.maic-case-file text { display: block; font-size: 27rpx; line-height: 1.72; }
.maic-case-file text:first-child { margin-bottom: 16rpx; color: var(--color-maic-blue); font-family: var(--font-mono); font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; }
.maic-pbl-node { padding: 28rpx; border: 1rpx solid var(--color-maic-border); border-radius: 4rpx 22rpx 22rpx 22rpx; background: var(--color-maic-surface); }
.maic-pbl-node__meta { display: flex; justify-content: space-between; gap: 18rpx; margin-bottom: 20rpx; color: var(--color-maic-blue); font-family: var(--font-serif); font-size: 27rpx; font-weight: 700; }
.maic-pbl-node__narrative { display: block; margin-bottom: 24rpx; color: var(--color-maic-ink-soft); font-size: 28rpx; line-height: 1.75; }

.maic-teacher {
  position: relative;
  z-index: 6;
  display: grid;
  grid-template-columns: 76rpx 1fr;
  align-items: center;
  gap: 18rpx;
  min-height: 148rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  color: var(--color-on-primary);
  background: var(--color-maic-ink);
}

.maic-teacher__avatar { position: relative; width: 72rpx; height: 72rpx; overflow: hidden; border: 3rpx solid var(--color-maic-cyan); border-radius: 24rpx 24rpx 8rpx 24rpx; background: var(--color-maic-soft); }
.maic-teacher__head { position: absolute; top: 13rpx; left: 24rpx; width: 25rpx; height: 25rpx; border-radius: 50%; background: var(--color-maic-blue); }
.maic-teacher__body { position: absolute; bottom: -12rpx; left: 13rpx; width: 48rpx; height: 45rpx; border-radius: 50% 50% 0 0; background: var(--color-maic-cyan); }
.maic-teacher__content { min-width: 0; }
.maic-teacher__meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 7rpx; font-size: 20rpx; font-weight: 600; }
.maic-teacher__meta text:last-child { color: var(--color-maic-cyan); font-weight: 400; }
.maic-teacher__speech { display: -webkit-box; overflow: hidden; color: var(--color-maic-soft); font-size: 24rpx; line-height: 1.45; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.maic-teacher__timeline { height: 4rpx; margin-top: 10rpx; overflow: hidden; background: var(--color-maic-ink-soft); }
.maic-teacher__timeline view { height: 100%; background: var(--color-maic-cyan); transition: width var(--t-base) var(--ease-out); }

.maic-laser { position: absolute; z-index: 10; width: 26rpx; height: 26rpx; transform: translate(-50%, -50%); border: 5rpx solid var(--color-on-primary); border-radius: 50%; background: var(--color-danger); box-shadow: 0 0 0 12rpx var(--color-maic-danger-ring); pointer-events: none; }

.maic-player__nav {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 15rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-maic-border);
  background: var(--color-maic-surface);
  box-shadow: var(--shadow-maic-nav);
}

.maic-player__nav-copy { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; color: var(--color-maic-muted); font-size: 21rpx; }
.maic-player__nav-copy text:first-child { color: var(--color-maic-blue); }
.maic-player__nav-actions { display: grid; grid-template-columns: 1fr 2.1fr; gap: 14rpx; }
.maic-player__nav button { height: 74rpx; margin: 0; border-radius: 4rpx 18rpx 18rpx 18rpx; font-size: 27rpx; font-weight: 600; line-height: 74rpx; }
.maic-player__nav button::after { border: none; }
.maic-player__prev { border: 1rpx solid var(--color-maic-border); color: var(--color-maic-ink-soft); background: var(--color-maic-bg); }
.maic-player__next { color: var(--color-on-primary); background: var(--color-maic-blue); box-shadow: var(--shadow-maic-blue); }
.maic-player__next[disabled] { color: var(--color-maic-muted); background: var(--color-maic-border); box-shadow: none; }
