<ui-page>
  <!-- 应用头部 + 费用提示 -->
  <view class="app-exec-header app-exec-header--draw">
    <view class="app-exec-header__row">
      <view class="icon-tile icon-tile--app icon-tile--peach icon-tile--image">
        <view class="icon-tile__glyph"></view>
      </view>
      <view class="app-exec-header__info">
        <text class="app-exec-header__name">{{appInfo ? appInfo.name : 'AI 绘图'}}</text>
        <text class="app-exec-header__cost">本次消耗 {{appInfo && appInfo.pricing ? appInfo.pricing.costPoints : 1}} 积分</text>
      </view>
    </view>
  </view>

  <!-- 表单卡 -->
  <ui-form-field label="绘图描述">
    <textarea
      class="prompt-input"
      value="{{prompt}}"
      bindinput="onInputPrompt"
      placeholder="请描述您想要的图片，例如：一只可爱的猫咪在草地上奔跑"
      maxlength="500"
      auto-height
    />
    <text class="char-count">{{prompt.length}}/500</text>
  </ui-form-field>

  <!-- 主操作区 -->
  <view class="app-exec-actions">
    <ui-action-button
      text="{{loading ? '提交中...' : (polling ? '后台生成中' : '生成图片')}}"
      loading="{{loading}}"
      disabled="{{loading || polling || hasActiveTask || !prompt}}"
      bind:tap="onGenerate"
      extra-class="app-exec-btn"
    />
    <button
      wx:if="{{polling || hasActiveTask}}"
      type="warn"
      size="mini"
      bindtap="onCancel"
      class="app-exec-cancel"
    >
      取消
    </button>
  </view>

  <!-- 后台任务状态 -->
  <view wx:if="{{polling || hasActiveTask || taskStatusText}}" class="card card--soft app-exec-task">
    <view class="app-exec-task__spinner"></view>
    <view class="app-exec-task__body">
      <text class="app-exec-task__title">{{taskStatusText || '任务已提交，正在后台生成'}}</text>
      <text class="app-exec-task__desc">可以停留等待，也可以稍后返回本页查看结果</text>
    </view>
  </view>

  <!-- 结果区 -->
  <view wx:if="{{imageUrl}}" class="card card--elevated app-exec-result">
    <text class="app-exec-result__label">生成结果</text>
    <image class="result-image" mode="aspectFit" src="{{imageUrl}}" show-menu-by-longpress />
    <button class="save-btn" type="default" bindtap="onSaveImage">保存到相册</button>
  </view>

  <!-- 错误 -->
  <view wx:if="{{errorMsg}}" class="app-exec-error">
    <text>{{errorMsg}}</text>
  </view>
</ui-page>
