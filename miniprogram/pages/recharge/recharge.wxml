<ui-page title="积分充值" subtitle="选择充值包为账户增加积分">
  <view wx:if="{{loading}}">
    <ui-card>
      <text class="loading-state">正在加载充值包...</text>
    </ui-card>
  </view>

  <view wx:elif="{{packages.length === 0}}">
    <ui-empty text="暂无充值包" />
  </view>

  <view wx:else>
    <view
      wx:for="{{packages}}"
      wx:key="packageKey"
      class="pkg-card card"
    >
      <view class="pkg-card__header">
        <view class="pkg-card__title">
          <text class="pkg-card__name">{{item.name}}</text>
          <text class="pkg-card__price">¥{{item.amountYuan}}</text>
        </view>
      </view>
      <view class="care-divider"></view>
      <view class="pkg-card__body">
        <view class="pkg-card__row">
          <text class="pkg-card__label">基础积分</text>
          <text class="pkg-card__val">{{item.basePoints}}</text>
        </view>
        <view wx:if="{{item.bonusPoints > 0}}" class="pkg-card__row">
          <text class="pkg-card__label">赠送积分</text>
          <text class="pkg-card__val pkg-card__val--bonus">+{{item.bonusPoints}}</text>
        </view>
        <view class="pkg-card__row pkg-card__row--total">
          <text class="pkg-card__label">到账总计</text>
          <ui-price value="{{item.basePoints + item.bonusPoints}}" type="points" size="md" suffix=" 积分" />
        </view>
      </view>
      <button
        type="primary"
        size="mini"
        loading="{{creating}}"
        disabled="{{creating}}"
        data-pkg="{{item}}"
        bindtap="onCreateOrder"
        class="pkg-card__btn"
      >创建订单</button>
    </view>
  </view>

  <view wx:if="{{payingOrderNo}}" class="card mock-card">
    <text class="form-label">模拟支付（开发/测试）</text>
    <text class="mock-card__order">订单号: {{payingOrderNo}}</text>
    <button
      type="warn"
      size="mini"
      loading="{{paying}}"
      disabled="{{paying}}"
      bindtap="onMockPay"
    >模拟支付到账</button>
  </view>

  <view class="card link-card" bindtap="onGoOrders">
    <text class="link-card__text">查看我的订单</text>
    <text class="menu-item__arrow">›</text>
  </view>
</ui-page>
