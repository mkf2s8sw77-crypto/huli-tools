/* 首页 v3 — 自然疗愈仪表盘 */

/* ── 免费开放提示 ── */
.free-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--gradient-hero);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg) var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-elevated);
  position: relative;
  overflow: hidden;
}
.free-hero::after {
  content: "";
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--color-on-primary);
  opacity: 0.10;
}
.free-hero__main {
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}
.free-hero__eyebrow {
  font-size: 24rpx;
  color: var(--color-on-primary);
  opacity: 0.85;
  margin-bottom: 10rpx;
  letter-spacing: 0.5rpx;
}
.free-hero__title {
  font-size: 42rpx;
  font-weight: 600;
  color: var(--color-on-primary);
  line-height: 1.2;
  display: block;
}
.free-hero__desc {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--color-on-primary);
  opacity: 0.82;
}
.free-hero__mark {
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.54);
  border-radius: 50%;
  position: relative;
  z-index: 1;
  flex-shrink: 0;
}
.free-hero__mark::before {
  content: "";
  position: absolute;
  left: 22rpx;
  top: 17rpx;
  width: 24rpx;
  height: 14rpx;
  border-left: 5rpx solid var(--color-on-primary);
  border-bottom: 5rpx solid var(--color-on-primary);
  transform: rotate(-45deg);
}

/* ── 应用卡片(骨架 A) ── */
.app-card {
  display: flex;
  align-items: center;
  padding: 28rpx 26rpx;
  margin-bottom: 20rpx;
  background: var(--color-bg-card);
  border-color: var(--color-border-soft);
  box-shadow: var(--shadow-card);
  cursor: pointer;
}
.app-card:last-child { margin-bottom: 0; }

.app-card__body {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}
.app-card__icon { flex-shrink: 0; }
.app-card__info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}
.app-card__title-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: 6rpx;
}
.app-card__name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.25;
}
.app-card__desc {
  display: block;
  font-size: 25rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.app-card__cost {
  display: flex;
  align-self: flex-start;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  box-sizing: border-box;
  background: var(--color-accent-warm-light);
  border-radius: var(--radius-pill);
  padding: 0 18rpx;
  margin-top: 10rpx;
}
.app-card__cost-text {
  display: block;
  font-size: 23rpx;
  color: var(--color-accent-warm);
  font-weight: 600;
  line-height: 1;
}

.app-card__arrow {
  width: 44rpx;
  height: 44rpx;
  margin-left: var(--spacing-sm);
  border-radius: 50%;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
  transition: background var(--t-fast) var(--ease-out);
}
.app-card:active .app-card__arrow {
  background: var(--color-primary-light);
}
.app-card__arrow::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 4rpx solid var(--color-primary);
  border-right: 4rpx solid var(--color-primary);
  border-radius: 2rpx;
  transform: rotate(45deg);
}
