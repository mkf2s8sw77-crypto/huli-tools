<ui-page title="{{appInfo ? appInfo.name : 'AI 绘图'}}" subtitle="输入描述，AI 为您生成图片">
  <!-- 应用头部 + 费用提示 -->
  <view class="app-exec-header card card--soft" wx:if="{{appInfo && appInfo.pricing}}">
    <view class="app-exec-header__row">
      <view class="app-icon-symbol app-icon-symbol--peach">
        <text>画</text>
      </view>
      <view class="app-exec-header__info">
        <text class="app-exec-header__name">{{appInfo.name || 'AI 绘图'}}</text>
        <text class="app-exec-header__cost">本次消耗 {{appInfo.pricing.costPoints}} 积分</text>
      </view>
    </view>
  </view>

  <!-- 表单卡 -->
  <ui-form-field label="绘图描述">
    <textarea
      class="prompt-input"
      value="{{prompt}}"
      bindinput="onInputPrompt"
      placeholder="请描述您想要的图片，例如：一只可爱的猫咪在草地上奔跑"
      maxlength="500"
      auto-height
    />
    <text class="char-count">{{prompt.length}}/500</text>
  </ui-form-field>

  <!-- 主操作区 -->
  <view class="app-exec-actions">
    <ui-action-button
      text="{{loading ? '生成中...' : (polling ? '生成中(' + pollCount + ')...' : '生成图片')}}"
      loading="{{loading || polling}}"
      disabled="{{loading || polling || !prompt}}"
      bind:tap="onGenerate"
      extra-class="app-exec-btn"
    />
    <button
      wx:if="{{polling}}"
      type="warn"
      size="mini"
      bindtap="onCancel"
      class="app-exec-cancel"
    >
      取消
    </button>
  </view>

  <!-- 结果区 -->
  <view wx:if="{{imageUrl}}" class="card card--elevated app-exec-result">
    <text class="app-exec-result__label">生成结果</text>
    <image class="result-image" mode="aspectFit" src="{{imageUrl}}" show-menu-by-longpress />
    <button class="save-btn" type="default" bindtap="onSaveImage">保存到相册</button>
  </view>

  <!-- 错误 -->
  <view wx:if="{{errorMsg}}" class="app-exec-error">
    <text>{{errorMsg}}</text>
  </view>
</ui-page>
