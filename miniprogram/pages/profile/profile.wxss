/* 我的页面 v3 — 自然疗愈账户面板 */

.account-card {
  position: relative;
  border-radius: var(--radius-xl);
  overflow: hidden;
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-elevated);
}

.account-card__bg {
  position: absolute;
  inset: 0;
  background: var(--gradient-hero);
}
.account-card__bg::after {
  content: "";
  position: absolute;
  top: -60rpx;
  right: -30rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: var(--color-on-primary);
  opacity: 0.10;
}

.account-card__content {
  position: relative;
  z-index: 1;
  padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-lg);
  color: var(--color-on-primary);
}

.account-card__label {
  font-size: 24rpx;
  color: var(--color-on-primary);
  opacity: 0.85;
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: 0.5rpx;
}

.account-card__balance {
  font-size: 80rpx;
  font-weight: 600;
  line-height: 1.05;
  display: block;
  font-variant-numeric: tabular-nums;
}

.account-card__details {
  display: flex;
  gap: var(--spacing-lg);
}

.account-card__detail {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.account-card__detail-label {
  font-size: 20rpx;
  color: var(--color-on-primary);
  opacity: 0.7;
}
.account-card__detail-value {
  font-size: 28rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.account-card__detail-value--warning {
  color: var(--color-lemon-light);
}

/* ── 身份栏(独立卡) ── */
.id-bar {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-card);
}

.id-bar__text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-family: var(--font-mono);
}

.brand-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  box-shadow: var(--shadow-soft);
}
