/* 首页 v4.1 — Bento 工具墙 */

/* ── 顶栏:品牌 + 积分胶囊 ── */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
}
.brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.brand__logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(124, 92, 252, 0.35);
}
.brand__name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: 0.5rpx;
}
.points-pill {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  padding: 14rpx 28rpx;
  border-radius: var(--radius-pill);
  box-shadow: 0 6rpx 20rpx rgba(124, 92, 252, 0.10);
  transition: transform var(--t-fast) var(--ease-out);
}
.points-pill:active {
  transform: scale(0.95);
}
.points-pill__bolt {
  width: 20rpx;
  height: 28rpx;
  background: var(--color-primary);
  clip-path: polygon(62% 0, 14% 56%, 42% 56%, 36% 100%, 86% 40%, 56% 40%);
}
.points-pill__num {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-primary);
  font-variant-numeric: tabular-nums;
}

/* ── slogan ── */
.slogan {
  display: flex;
  flex-direction: column;
  padding: var(--spacing-sm) 4rpx var(--spacing-md);
}
.slogan__main {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: -0.5rpx;
  line-height: 1.25;
}
.slogan__sub {
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin-top: 12rpx;
}

/* ── bento 工具墙 ── */
.bento {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-auto-rows: 300rpx;
  gap: 28rpx;
}
.tile {
  border-radius: 44rpx;
  padding: 36rpx;
  position: relative;
  overflow: hidden;
  color: var(--color-on-primary);
  display: flex;
  flex-direction: column;
  transition: transform var(--t-fast) var(--ease-out);
}
.tile:active {
  transform: scale(0.97);
}
.tile--tall {
  grid-row: span 2;
}
.tile__spacer {
  flex: 1;
}

/* 主题砖 */
.tile--photo {
  background: var(--gradient-tile-photo);
  box-shadow: var(--shadow-tile-photo);
}
.tile--game {
  background: var(--gradient-tile-game);
  box-shadow: var(--shadow-tile-game);
}
.tile--maic {
  background: var(--gradient-tile-maic);
  box-shadow: var(--shadow-tile-maic);
}
.tile--paper-polish {
  background: var(--gradient-tile-polish);
  box-shadow: var(--shadow-tile-polish);
}

/* 浅色砖(未映射应用默认) */
.tile--plain {
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
  color: var(--color-text);
}
.tile--plain .tile__name {
  color: var(--color-text);
  text-shadow: none;
}
.tile--plain .tile__desc {
  color: var(--color-text-muted);
  opacity: 1;
}
.tile--plain .tile__price {
  background: var(--color-primary-light);
  color: var(--color-primary);
}
.tile--plain .tile__price--free {
  background: var(--color-success-light);
  color: var(--color-success);
}
.tile--plain .tile__tag {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

/* 几何装饰(纯 CSS,半透明) */
.tile__glyph {
  position: absolute;
  right: -28rpx;
  bottom: -28rpx;
  width: 220rpx;
  height: 220rpx;
  opacity: 0.22;
  pointer-events: none;
}
.tile__glyph::before,
.tile__glyph::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}
/* 定妆照:人像线框(头 + 肩) */
.tile--photo .tile__glyph::before {
  left: 62rpx;
  top: 26rpx;
  width: 96rpx;
  height: 96rpx;
  border: 7rpx solid #ffffff;
  border-radius: 50%;
}
.tile--photo .tile__glyph::after {
  left: 14rpx;
  top: 140rpx;
  width: 192rpx;
  height: 96rpx;
  border: 7rpx solid #ffffff;
  border-bottom: none;
  border-radius: 96rpx 96rpx 0 0;
}
/* 卧底:大问号 */
.tile--game .tile__glyph {
  width: 200rpx;
  height: 200rpx;
}
.tile--game .tile__glyph::before {
  content: "?";
  left: 0;
  top: -30rpx;
  width: 100%;
  font-size: 200rpx;
  font-weight: 800;
  line-height: 1;
  color: #ffffff;
  text-align: center;
  border: none;
}
/* MAIC:展开的书本线框 */
.tile--maic .tile__glyph::before {
  left: 20rpx;
  top: 60rpx;
  width: 80rpx;
  height: 110rpx;
  border: 7rpx solid #ffffff;
  border-right: none;
  border-radius: 12rpx 0 0 12rpx;
}
.tile--maic .tile__glyph::after {
  left: 100rpx;
  top: 60rpx;
  width: 80rpx;
  height: 110rpx;
  border: 7rpx solid #ffffff;
  border-left: none;
  border-radius: 0 12rpx 12rpx 0;
}
/* 默认:大圆 */
.tile--plain .tile__glyph::before {
  left: 30rpx;
  top: 30rpx;
  width: 160rpx;
  height: 160rpx;
  border: 7rpx solid var(--color-primary);
  border-radius: 50%;
}

/* 角标 */
.tile__tag {
  align-self: flex-start;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
}
.tile__tag--hot {
  background: var(--color-accent-warm);
}

/* 文案 */
.tile__name {
  font-size: 34rpx;
  font-weight: 800;
  color: inherit;
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.12);
  line-height: 1.25;
  position: relative;
}
.tile__desc {
  font-size: 23rpx;
  color: inherit;
  opacity: 0.85;
  margin-top: 10rpx;
  line-height: 1.45;
  position: relative;
}
.tile__price {
  margin-top: 18rpx;
  align-self: flex-start;
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.92);
  color: var(--color-primary);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  font-variant-numeric: tabular-nums;
  position: relative;
}
.tile__price--free {
  color: var(--color-success);
}

/* ── 更多工具占位砖(虚线) ── */
.tile--more {
  grid-column: span 2;
  grid-row: span 1;
  background: var(--color-bg-card);
  border: 3rpx dashed #D9D2EC;
  box-shadow: none;
  color: var(--color-text-muted);
  flex-direction: row;
  align-items: center;
  gap: 28rpx;
}
.tile--more:active {
  transform: none;
}
.tile-more__plus {
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  flex: none;
}
.tile-more__texts {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.tile-more__name {
  font-size: 28rpx;
  font-weight: 800;
  color: #6E6590;
}
.tile-more__desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
}
