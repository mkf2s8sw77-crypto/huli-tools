.container {
  padding: 32rpx;
}

.header {
  margin-bottom: 48rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #1a1a1a;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.cost-points {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #ff9900;
}

.prompt-input {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.image-card {
  text-align: center;
}

.result-image {
  width: 100%;
  max-height: 800rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.save-btn {
  margin-top: 16rpx;
}

.btn-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.cancel-btn {
  margin-top: 8rpx;
}

.error {
  color: #fa5151;
}

.error text {
  display: block;
  font-size: 28rpx;
  text-align: center;
}
