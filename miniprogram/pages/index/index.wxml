<ui-page variant="dashboard">
  <view wx:if="{{loading}}">
    <ui-card>
      <view class="skeleton" style="height: 96rpx; border-radius: 16rpx;"></view>
    </ui-card>
  </view>

  <view wx:elif="{{error}}">
    <ui-error text="{{error}}" bind:retry="loadHomeData" />
  </view>

  <view wx:else>
    <view class="free-hero fade-in">
      <view class="free-hero__main">
        <text class="free-hero__eyebrow">huli 工具箱</text>
        <text class="free-hero__title serif-num">全部工具免费开放</text>
        <text class="free-hero__desc">选择下方工具即可直接使用</text>
      </view>
      <view class="free-hero__mark" aria-hidden="true"></view>
    </view>

    <!-- 应用目录(骨架 A 列表) -->
    <view class="fade-in fade-in-2">
      <ui-section title="应用目录">
        <ui-empty wx:if="{{apps.length === 0}}" text="暂无可用应用" />

        <view
          wx:for="{{apps}}"
          wx:key="appKey"
          class="app-card card lift-on-hover"
          data-app="{{item}}"
          bindtap="onTapApp"
        >
          <view class="app-card__body">
            <view class="app-card__icon icon-tile icon-tile--app {{item.iconClass}}">
              <view class="icon-tile__glyph"></view>
            </view>
            <view class="app-card__info">
              <view class="app-card__title-row">
                <text class="app-card__name serif-num">{{item.name}}</text>
                <ui-status wx:if="{{item.status === 'coming_soon'}}" text="即将上线" type="warning" />
              </view>
              <text class="app-card__desc">{{item.description || ''}}</text>
              <view class="app-card__cost">
                <text class="app-card__cost-text serif-num">免费使用</text>
              </view>
            </view>
          </view>
          <view class="app-card__arrow"></view>
        </view>
      </ui-section>
    </view>
  </view>
</ui-page>
