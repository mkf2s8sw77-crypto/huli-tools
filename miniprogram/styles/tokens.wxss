/* huli-tools 设计系统 v4.1 — Bento 工具墙
   冷白紫调底色 · 活力紫品牌 · 珊瑚橙价格强调
   衬线字体已移除:标题/数值统一 sans + font-weight:800 + tabular-nums。
   替代 v3 的"自然疗愈"暖米陶土调性。 */

page {
  /* ── 背景层(冷白带紫调) ── */
  --color-bg: #F6F5FA;          /* 页面底色 */
  --color-surface: #F7F6FC;     /* 输入框/卡内嵌区 */
  --color-surface-elevated: #ffffff;
  --color-bg-card: #ffffff;
  --color-border: #EEEAF7;      /* 卡片描边 */
  --color-border-soft: #F4F1FA; /* 卡内分隔线 */

  /* ── 主色:活力紫(沪里品牌色) ── */
  --color-primary: #7C5CFC;
  --color-primary-hover: #6D3FE8; /* deep/选中态 */
  --color-primary-bright: #9F7BFA;
  --color-primary-light: #F0EDFA; /* 淡紫底 */
  --color-on-primary: #ffffff;

  /* ── 品牌辅色:青绿(MAIC/免费语义) ── */
  --color-brand-soft: #0DA593;
  --color-brand-soft-bright: #3ED0BC;
  --color-brand-soft-light: #D6F4F1;

  /* ── 暖调强调:珊瑚橙(价格/推荐角标) ── */
  --color-accent-warm: #FF7A59;
  --color-accent-warm-bright: #FF9A6B;
  --color-accent-warm-light: #FFE9E2;

  /* ── 扩展色(对齐新色板,供旧类名继续引用) ── */
  --color-peach: #FF9A6B;          /* 珊瑚亮橙 */
  --color-peach-light: #FFE9E2;
  --color-lemon: #B8904A;          /* 琥珀(同 warning) */
  --color-lemon-light: #F0E5C8;
  --color-lavender: #9F7BFA;       /* 亮紫 */
  --color-lavender-light: #F0EDFA;

  /* ── 语义色 ── */
  --color-success: #0DA593;
  --color-success-light: #D6F4F1;
  --color-warning: #B8904A;
  --color-warning-light: #F0E5C8;
  --color-danger: #E8563A;
  --color-danger-light: #FFE9E2;

  /* ── 文字色(冷墨紫) ── */
  --color-text: #18142A;
  --color-text-secondary: #5A5468;
  --color-text-muted: #9A93B0;

  /* ── 语义色 ── */
  --color-price: #FF7A59;   /* 价格珊瑚橙 */
  --color-points: #7C5CFC;  /* 积分品牌紫 */

  /* ── MAIC 业务品牌色(仅 MAIC 内容区使用) ── */
  --color-maic-bg: #F4F7FB;
  --color-maic-surface: #FFFFFF;
  --color-maic-ink: #0F172A;
  --color-maic-ink-soft: #1E293B;
  --color-maic-blue: #2563EB;
  --color-maic-cyan: #0891B2;
  --color-maic-muted: #64748B;
  --color-maic-border: #CBD5E1;
  --color-maic-soft: #E0F2FE;
  --color-maic-overlay: rgba(255, 255, 255, 0.14);
  --color-maic-overlay-strong: rgba(255, 255, 255, 0.90);
  --color-maic-spotlight-mask: rgba(15, 23, 42, 0.34);
  --color-maic-danger-ring: rgba(232, 86, 58, 0.20);
  --shadow-maic-soft: 0 10rpx 30rpx rgba(15, 23, 42, 0.15);
  --shadow-maic: 0 26rpx 60rpx rgba(15, 23, 42, 0.20);
  --shadow-maic-blue: 0 10rpx 26rpx rgba(37, 99, 235, 0.22);
  --shadow-maic-nav: 0 -12rpx 36rpx rgba(15, 23, 42, 0.10);

  /* ── 微信绿保留(仅微信登录按钮) ── */
  --color-wechat: #07c160;

  /* ── 圆角(卡片 20px / 磁贴 22px / 按钮 14px / 胶囊) ── */
  --radius-sm: 4px;
  --radius-md: 14px;     /* 按钮 */
  --radius-lg: 20px;     /* 卡片 */
  --radius-xl: 24px;     /* hero */
  --radius-tile: 22px;   /* bento 磁贴 */
  --radius-pill: 999px;

  /* ── 阴影(紫调轻阴影) ── */
  --shadow-soft: 0 6px 18px rgba(60, 40, 110, 0.05);
  --shadow-card: 0 6px 18px rgba(60, 40, 110, 0.05);
  --shadow-elevated: 0 14px 34px rgba(124, 92, 252, 0.32);

  /* ── 间距 ── */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* ── 页面底色(纯色,无渐变) ── */
  --page-gradient: #F6F5FA;

  /* ── 渐变 ── */
  --gradient-primary: linear-gradient(135deg, #7C5CFC 0%, #9F7BFA 100%);
  --gradient-hero: linear-gradient(140deg, #7C5CFC 0%, #9F7BFA 60%, #B893F6 100%);
  --gradient-brand-soft: linear-gradient(150deg, #0DA593 0%, #14B8A6 60%, #3ED0BC 100%);
  --gradient-warm: linear-gradient(135deg, #FF7A59 0%, #FF9A6B 100%);
  --gradient-peach: linear-gradient(135deg, #FF7A59 0%, #FF9A6B 100%);
  --gradient-lemon: linear-gradient(135deg, #B8904A 0%, #D6BA68 100%);
  --gradient-lavender: linear-gradient(150deg, #4F46E5 0%, #6366F1 60%, #8B7CF6 100%);

  /* ── Bento 磁贴主题(首页工具墙) ── */
  --gradient-tile-photo: linear-gradient(150deg, #7C5CFC 0%, #B458E8 55%, #E05FA8 100%);
  --gradient-tile-game: linear-gradient(150deg, #4F46E5 0%, #6366F1 60%, #8B7CF6 100%);
  --gradient-tile-maic: linear-gradient(150deg, #0DA593 0%, #14B8A6 60%, #3ED0BC 100%);
  --shadow-tile-photo: 0 28rpx 68rpx rgba(124, 92, 252, 0.35);
  --shadow-tile-game: 0 20rpx 52rpx rgba(79, 70, 229, 0.30);
  --shadow-tile-maic: 0 20rpx 52rpx rgba(13, 165, 147, 0.30);

  /* ── 微动效时长(可复用) ── */
  --t-fast: 120ms;
  --t-base: 200ms;
  --t-slow: 360ms;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);

  /* ── 字体(无衬线;数字用 800 + tabular-nums) ── */
  --font-sans: -apple-system, BlinkMacSystemFont, "PingFang SC",
               "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  --font-mono: "JetBrains Mono", "SF Mono", Consolas, monospace;

  font-family: var(--font-sans);
  background: var(--page-gradient);
  color: var(--color-text);
}
